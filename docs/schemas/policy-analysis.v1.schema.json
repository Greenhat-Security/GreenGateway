{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/policy-analysis.v1.schema.json",
  "title": "GreenGateway policy analysis request",
  "description": "Draft 2020-12 JSON Schema for a policy-analysis.v1 request: a pinned base ETag, a candidate (the active policy, position-aware edits over it, or an inline policy document, exactly as in a policy-simulation.v1 request) and an output format. The gateway's parser is authoritative and also enforces what JSON Schema cannot state here: byte (not character) limits, unique member names, and that an edit's position exists. Whether a candidate is a valid policy is the policy validator's answer. Unknown members are refused everywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_etag", "candidate"],
  "properties": {
    "schema_version": {"const": "policy-analysis.v1"},
    "description": {"$ref": "#/$defs/description"},
    "base_etag": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate": {"$ref": "#/$defs/candidate"},
    "format": {"enum": ["json", "sarif"]}
  },
  "$defs": {
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "position": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "element_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "section": {"enum": ["rules", "routes", "rate_limits"]},
    "element": {"type": "object"},
    "edit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position", "value"],
          "properties": {
            "op": {"const": "insert"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "value": {"$ref": "#/$defs/element"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position", "value"],
          "properties": {
            "op": {"const": "replace"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"},
            "value": {"$ref": "#/$defs/element"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "from", "to"],
          "properties": {
            "op": {"const": "move"},
            "section": {"$ref": "#/$defs/section"},
            "from": {"$ref": "#/$defs/position"},
            "to": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position"],
          "properties": {
            "op": {"const": "delete"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": {"const": "set"},
            "field": {"const": "default_action"},
            "value": {"enum": ["allow", "deny"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": {"const": "set"},
            "field": {"const": "enforcement_mode"},
            "value": {"enum": ["enforce", "shadow"]}
          }
        }
      ]
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {"source": {"const": "active"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "edits"],
          "properties": {
            "source": {"const": "edits"},
            "edits": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/edit"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "policy"],
          "properties": {"source": {"const": "inline"}, "policy": {"type": "object"}}
        }
      ]
    }
  }
}

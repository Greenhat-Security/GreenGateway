# Address the gateway listens on.
# Default: 0.0.0.0:8080
LISTEN_ADDR=0.0.0.0:8080

# Optional address for serving only the admin UI/control-plane API.
# Default: empty (admin surface served on LISTEN_ADDR)
ADMIN_LISTEN_ADDR=

# Optional address for the transparent gRPC (HTTP/2) listener.
# Unset means no HTTP/2 server is constructed at all; this is off by default.
# Must differ from LISTEN_ADDR and ADMIN_LISTEN_ADDR: this listener speaks HTTP/2
# and nothing else, and the other two refuse an HTTP/2 preface, so a shared
# address would leave one of them unable to answer.
# Deployment: plaintext h2c prior knowledge, behind a terminator that
# re-originates h2c (nginx grpc_pass, Envoy). See docs/deployment/grpc.md.
# Default: empty (no gRPC listener)
GRPC_LISTEN_ADDR=

# Maximum concurrent HTTP/2 streams per gRPC connection.
# One accepted connection becomes up to this many in-flight calls, so the real
# inbound ceiling is this multiplied by the connection cap.
# Default: 100
GRPC_MAX_CONCURRENT_STREAMS=100

# Maximum decoded size, in bytes, of one gRPC request's metadata.
# Raise it for callers that carry large bearer tokens in metadata.
# Default: 16384
GRPC_MAX_METADATA_BYTES=16384

# Optional PEM certificate chain and private key that terminate TLS on LISTEN_ADDR. Leaf certificate first.
# Both accept a comma-separated list of paths, positionally paired, one key per certificate chain; a single path is the simplest shape. With more than one chain the listener selects by SNI: each chain answers to the DNS SANs on its leaf, an exact name beats a wildcard, a wildcard matches exactly one label, and the FIRST chain serves callers that name nothing recognised. Paths containing commas cannot be expressed.
# Set both or neither -- and with equal list lengths -- or startup fails rather than serving plaintext.
# The key must grant no group or other permission at all -- not read, not write -- and its directory must not be group- or world-writable unless it carries the sticky bit (which is what a Kubernetes secret mount looks like). Kubernetes publishes Secret volume files 0644 by default, which is refused: set `defaultMode: 0400`, or `chmod 0400` for a bind mount. The certificate is public material and may stay world-readable.
# Default: empty (LISTEN_ADDR serves plaintext HTTP/1.1)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Optional PEM certificate chain and private key that terminate TLS on ADMIN_LISTEN_ADDR, independently of TLS_CERT_FILE/TLS_KEY_FILE, with the same comma-separated multi-chain and SNI behaviour.
# Requires ADMIN_LISTEN_ADDR: without a separate admin listener there is nothing for them to terminate.
# Default: empty (the admin listener serves plaintext HTTP/1.1)
ADMIN_TLS_CERT_FILE=
ADMIN_TLS_KEY_FILE=

# Minimum TLS protocol version any inbound listener will negotiate. Accepts 1.2 or 1.3.
# 1.3 is the stronger floor; it refuses clients that cannot speak TLS 1.3 at all.
# Default: 1.2
TLS_MIN_VERSION=1.2

# Deadline for one inbound TLS handshake, in milliseconds.
# A client that connects and never sends a ClientHello is dropped after this and its admission slot is released. It does not bound how long a legitimate client waits: a connection that finds no free slot is refused at once.
# Must be greater than 0.
# Default: 10000
TLS_HANDSHAKE_TIMEOUT_MS=10000

# Maximum inbound TLS handshakes running at once, per listener.
# Handshakes run off the accept path, so one slow client cannot stall the listener; this bounds how much handshake work an unauthenticated flood can create, per listener. Once the bound is reached the listener keeps accepting and closes what it cannot admit, counted as inbound_tls_handshakes_total{outcome="shed"}.
# Must be greater than 0.
# Default: 256
TLS_MAX_CONCURRENT_HANDSHAKES=256

# Whether LISTEN_ADDR asks callers for a client certificate. Accepts off, optional, or required.
# off (the default) requests nothing and behaves exactly as a listener without this setting.
# optional requests a certificate and still serves callers who decline; a caller who declines simply has no certificate identity and must authenticate some other way.
# required refuses the handshake when no certificate is offered.
# A certificate that is offered is verified identically in both modes: optional never means "trusted less".
# Requires TLS_CERT_FILE, CLIENT_CERT_CA_FILE, and CLIENT_CERT_IDENTITY_SOURCE. Anything missing fails startup.
# Default: off
CLIENT_CERT_MODE=off

# PEM bundle of the certificate authorities allowed to issue client certificates for LISTEN_ADDR.
# The platform trust store is never consulted for client authentication: trusting it would let any publicly issued certificate authenticate. There is no way to opt into it.
# Public material, so group and other *read* is fine; group or other *write* fails startup, because a bundle an attacker can rewrite is a bundle an attacker chooses. Every certificate in the file must be usable as a trust anchor -- one that is not fails startup rather than being skipped.
# Default: empty (required when CLIENT_CERT_MODE is not off)
CLIENT_CERT_CA_FILE=

# Optional PEM certificate revocation list(s) for LISTEN_ADDR client certificates.
# WITHOUT THIS SETTING NOTHING CHECKS REVOCATION. Neither CRLs nor OCSP are consulted by default, so a revoked certificate authenticates until it expires.
# With it, the whole verified chain is checked, a status that cannot be determined is a failure, and an expired CRL is treated as no CRL rather than as a still-valid one -- which means a CRL you stop refreshing eventually refuses every caller. That is deliberate: the alternative is a deployment that has silently stopped checking revocation.
# Default: empty (no revocation checking)
CLIENT_CERT_CRL_FILE=

# Which field of a verified client certificate carries the caller's identity. Accepts spiffe, uri, or dns.
# spiffe: the one URI SAN whose scheme is spiffe. Recommended: exactly one per SVID by specification, canonical, and stable across renewal.
# uri: the one URI SAN, verbatim.
# dns: the one DNS SAN, lower-cased. Weakest: DNS SANs commonly appear several to a certificate, and a certificate with several has no identity.
# The rule is exactly one: a certificate carrying none of the configured kind, or two different ones, has NO identity and authenticates as nobody. The gateway never takes the first of several.
# The subject DN is deliberately not offered; see docs/configuration.md.
# Applies to both listeners.
# Default: empty (required when either listener requests client certificates)
CLIENT_CERT_IDENTITY_SOURCE=

# The same three settings for ADMIN_LISTEN_ADDR, configured independently of the data listener.
# Require ADMIN_TLS_CERT_FILE. The identity source is shared: CLIENT_CERT_IDENTITY_SOURCE applies to both listeners.
# Default: off / empty / empty
ADMIN_CLIENT_CERT_MODE=off
ADMIN_CLIENT_CERT_CA_FILE=
ADMIN_CLIENT_CERT_CRL_FILE=

# Gateway admin UI/control-plane prefix.
# Changing this also changes which prefix is auto-exempted from auth/RBAC. If you set
# AUTH_EXEMPT_PATHS or RBAC_EXEMPT_PATHS explicitly below, update them to match this prefix.
# Default: /admin
ADMIN_PREFIX=/admin

# Optional admin UI OIDC login provider name. Must reference a jwt AUTH_PROVIDERS entry with issuer, client_id, client_secret, and redirect_uri.
# Default: empty (SSO login disabled; manual bearer-token paste still works)
ADMIN_LOGIN_PROVIDER=

# Maximum age, in seconds, for an unconsumed admin OIDC login state.
# Default: 300
ADMIN_LOGIN_PENDING_TTL_SECS=300

# Cluster mode only: keyring for sealing pending admin logins in PostgreSQL (same shape as CONNECTION_LOCAL_SECRET_KEYRING, files beneath CONNECTION_SECRETS_ROOT). Required when STATE_BACKEND=postgres and ADMIN_LOGIN_PROVIDER is set; rejected in sqlite mode.
# Default: empty
ADMIN_LOGIN_KEYRING=

# Cluster mode only: keyring whose primary key HMACs the shared rate limiter's bucket keys in PostgreSQL (same shape as CONNECTION_LOCAL_SECRET_KEYRING, files beneath CONNECTION_SECRETS_ROOT). Required when STATE_BACKEND=postgres; rejected when STATE_BACKEND=sqlite.
# Default: empty
RATE_LIMIT_KEYRING=

# Maximum number of pending admin OIDC login states retained process-wide.
# Default: 1024
ADMIN_LOGIN_PENDING_MAX_ENTRIES=1024

# Maximum number of pending admin OIDC login states retained per canonical client IP.
# Default: 16
ADMIN_LOGIN_PENDING_MAX_PER_IP=16

# Optional public base URL clients use to reach this gateway.
# Enables MCP OAuth protected-resource discovery and resource-bound JWT audience checks for /mcp.
# Example: https://gateway.example.com
# A path prefix also mounts <path>/mcp; that exact MCP alias always requires auth, RBAC, and CSRF even when the prefix is exempt.
# Startup warns when an MCP alias falls under AUTH_EXEMPT_PATHS or RBAC_EXEMPT_PATHS.
# Default: empty (OAuth protected-resource metadata disabled)
GATEWAY_PUBLIC_URL=

# Optional JSONL audit log file. Audit events are always written to stdout.
# Default: empty (no file sink)
AUDIT_LOG_FILE=

# Optional SQLite audit event store path for queryable local audit history.
# Default: empty (SQLite sink disabled)
AUDIT_SQLITE_PATH=

# Optional SQLite audit event retention window, in days. Ignored unless AUDIT_SQLITE_PATH is set.
# Default: empty (no SQLite pruning)
# 0 means the same as empty (pruning disabled). A literal zero-day window would delete the entire
# audit history on every prune tick, so set a positive day count to actually prune.
AUDIT_SQLITE_RETENTION_DAYS=

# Delay after readiness turns false and before listeners stop accepting work, in milliseconds.
# Set to 0 to stop listeners immediately. Maximum: 30000.
# Default: 1000
SHUTDOWN_DRAIN_DELAY_MS=1000

# Maximum time for listeners and registered background tasks to drain, in milliseconds.
# Must be between 1 and 300000.
# Default: 30000
SHUTDOWN_TIMEOUT_MS=30000

# Maximum time to flush queued audit events after application draining, in milliseconds.
# Must be between 1 and 60000.
# Default: 5000
AUDIT_DRAIN_TIMEOUT_MS=5000

# Optional SQLite endpoint discovery inventory store. Leave empty to disable aggregation.
# Default: empty (discovery aggregation disabled)
DISCOVERY_SQLITE_PATH=

# Maximum distinct (method, endpoint_template) aggregates retained in memory and
# in DISCOVERY_SQLITE_PATH. Least-recently-observed endpoints are evicted when
# the cap is reached. Must be greater than 0.
# Default: 10000
DISCOVERY_ENDPOINT_LIMIT=10000

# Cluster mode only: how long the discovery projector's leadership lease (the
# single slot one replica holds to project the durable audit stream into the
# shared discovery tables) lives on the database clock before another replica
# may take it, in milliseconds. Renewed at a third of this; at least 1000.
# Rejected when STATE_BACKEND=sqlite.
# Default: 15000
DISCOVERY_PROJECTOR_LEASE_TTL_MS=

# Cluster mode only: how long the discovery projector waits when the audit
# stream has nothing new before reading again, in milliseconds; also its retry
# wait after a transient flush failure. At least 50. Rejected when
# STATE_BACKEND=sqlite.
# Default: 250
DISCOVERY_PROJECTOR_POLL_MS=

# Cluster mode only: audit stream rows the discovery projector reads per batch
# (one bounded read, one bounded flush transaction). Between 1 and 5000.
# Rejected when STATE_BACKEND=sqlite.
# Default: 500
DISCOVERY_PROJECTOR_BATCH=

# Optional SQLite principal directory store. Leave empty to disable identity persistence.
# Default: empty (principal directory disabled)
PRINCIPAL_SQLITE_PATH=

# Optional durable SQLite control-plane store for managed Connections.
# Empty keeps legacy UPSTREAM_URL, UPSTREAM_ROUTES, and MCP_UPSTREAM_SERVERS
# behavior unchanged and exposes those entries only as read-only projections.
# Startup fails closed if this database cannot be opened, migrated, or validated.
# Default: empty (managed Connection mutations disabled)
CONNECTIONS_SQLITE_PATH=

# Optional encrypted-local-secret keyring. Each file is one safe filename
# segment below CONNECTION_SECRETS_ROOT and must contain exactly 32 raw bytes.
# Exactly one key is primary; predecessors are decrypt_only until every row is
# transactionally re-encrypted and verified unused. Key IDs and file locators
# are never returned by secret metadata APIs. Maximum: 8 entries / 16 KiB JSON.
# Requires both CONNECTIONS_SQLITE_PATH and CONNECTION_SECRETS_ROOT.
# Example shape:
# CONNECTION_LOCAL_SECRET_KEYRING=[{"id":"primary-2026-07","file":"local-secret-primary.key","role":"primary"},{"id":"previous-2026-06","file":"local-secret-previous.key","role":"decrypt_only"}]
# Default: [] (encrypted-local secret creation and rotation disabled)
CONNECTION_LOCAL_SECRET_KEYRING=[]

# Trusted startup-only operator aliases for upstream secret IDs. The source key
# is never accepted through an admin API or returned by metadata.
# Maximum: 512 entries / 256 KiB JSON. Values remain outside this JSON.
# Example shape:
# CONNECTION_SECRET_ALIASES=[{"id":"billing-token","label":"Billing token","source":{"type":"environment","key":"GGW_BILLING_TOKEN"}},{"id":"partner-ca","label":"Partner CA","source":{"type":"file","key":"partner-ca.pem"}}]
# Default: []
CONNECTION_SECRET_ALIASES=[]

# Canonical directory containing single-file operator alias values. Required
# when CONNECTION_SECRET_ALIASES contains a file source or
# CONNECTION_LOCAL_SECRET_KEYRING is configured. Files must be safe regular
# files with platform-appropriate restrictive permissions; links are rejected.
# Default: empty (file-backed aliases and encrypted-local keys unavailable)
CONNECTION_SECRETS_ROOT=

# Optional Vault KV v2 secret provider. Profiles define how to authenticate to
# one or more Vault clusters; aliases map opaque IDs to KV v2 data keys.
# Vault aliases are resolved asynchronously at request time and are validated on
# first use, not at startup. Alias IDs share the same namespace as operator
# aliases and other secret providers, and duplicate alias IDs are rejected at
# startup; profile IDs must be unique within this provider. The auth mount is
# the mount name only ("kubernetes"), not the "auth/" prefix. The Vault host
# must be present in EGRESS_ALLOWED_HOSTS.
# Maximum: 8 profiles, 512 aliases. Configuration Debug and errors redact
# addresses, namespaces, mounts, paths, keys, and all auth locators.
# Example shape:
# CONNECTION_VAULT_PROVIDER={"profiles":[{"id":"prod","address":"https://vault.internal:8200","auth":{"type":"workload_jwt","mount":"kubernetes","role":"gateway","token_root":"/var/run/secrets/tokens","token_file":"vault-token"}}],"aliases":[{"id":"billing-key","label":"Billing API key","profile":"prod","mount":"secret","path":"billing","key":"api-key"}]}
# Default: {} (Vault secret provider disabled)
CONNECTION_VAULT_PROVIDER={}

# Optional read-only Google Cloud Secret Manager provider. Profiles fix one
# Workload Identity Federation identity (projected subject-token file, full
# workload identity pool provider audience, optional service-account
# impersonation target); aliases map opaque IDs to exactly one secret version
# (project, optional location for regional secrets, secret ID, and a pinned
# numeric version or the `latest` alias when omitted). No ADC, CLI, user
# credential, metadata-server, or service-account-key mechanism exists.
# Aliases are resolved asynchronously at request time and are validated on
# first use, not at startup. Alias IDs share the same namespace as operator
# aliases and other secret providers, and duplicate alias IDs are rejected at
# startup; profile IDs must be unique within this provider.
# The STS, iamcredentials (only with impersonation), and secretmanager hosts
# must be present in EGRESS_ALLOWED_HOSTS.
# Maximum: 8 profiles, 512 aliases. Configuration Debug and errors redact
# audiences, token paths, service accounts, projects, locations, and secret IDs.
# Example shape:
# CONNECTION_GCP_PROVIDER={"profiles":[{"id":"gcp-prod","audience":"//iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/gateway-pool/providers/gateway-provider","token_root":"/var/run/secrets/tokens","token_file":"gcp-token","service_account":"gateway-secrets@example-project.iam.gserviceaccount.com"}],"aliases":[{"id":"gcp-billing-key","label":"Billing API key","profile":"gcp-prod","project":"example-project","secret":"billing-api-key"}]}
# Default: {} (Google Cloud Secret Manager provider disabled)
CONNECTION_GCP_PROVIDER={}
# Optional read-only Kubernetes Secrets API provider. Profiles define one
# explicit https API server (never derived from KUBERNETES_SERVICE_HOST or any
# in-cluster environment) plus its authentication (projected_token,
# bearer_alias, or client_certificate, the latter two bootstrapped from
# existing non-reveal aliases); aliases map opaque IDs to exactly one
# namespace, Secret name, and data key. The API-server host must be
# explicitly present in EGRESS_ALLOWED_HOSTS; cluster-local and private
# addresses additionally require an explicit egress policy CIDR. Kubernetes
# aliases are resolved asynchronously at request time and are validated on
# first use, not at startup. Profile and alias IDs share the same namespace as
# operator aliases and encrypted-local secrets; duplicates are rejected.
# Maximum: 8 profiles, 512 aliases. Configuration Debug and errors redact
# servers, namespaces, Secret names, data keys, and all auth locators.
# Example shape:
# CONNECTION_KUBERNETES_PROVIDER={"profiles":[{"id":"k8s-prod","server":"https://kubernetes.internal:6443","ca_bundle_root":"/var/run/secrets/kubernetes.io/serviceaccount","ca_bundle_file":"ca.crt","auth":{"type":"projected_token","token_root":"/var/run/secrets/tokens","token_file":"k8s-gateway-token"}}],"aliases":[{"id":"k8s-billing-key","label":"Billing API key","profile":"k8s-prod","namespace":"payments","name":"billing-credentials","key":"api-key"}]}
# Default: {} (Kubernetes secret provider disabled)
CONNECTION_KUBERNETES_PROVIDER={}

# Optional read-only Azure Key Vault Secrets provider. Profiles fix the Entra
# authority, tenant, client, and Key Vault token scope; aliases map opaque IDs
# to one Get Secret operation against a fixed vault authority and secret name.
# Azure aliases are resolved asynchronously at request time and are validated
# on first use, not at startup. Alias IDs share the same namespace as operator
# aliases and every other secret provider; duplicates are rejected. The Entra
# authority host and each vault authority host must also be present in
# EGRESS_ALLOWED_HOSTS. Maximum: 8 profiles, 512 aliases. Configuration Debug
# and errors redact authority hosts, tenant/client IDs, scopes, vault
# authorities, secret names, versions, and all auth locators.
# Example shape:
# CONNECTION_AZURE_PROVIDER={"profiles":[{"id":"azure-prod","tenant_id":"00000000-0000-0000-0000-000000000000","client_id":"00000000-0000-0000-0000-000000000000","auth":{"type":"workload_jwt","token_root":"/var/run/secrets/azure/tokens","token_file":"azure-identity-token"}}],"aliases":[{"id":"azure-billing-key","label":"Billing API key","profile":"azure-prod","vault":"https://example-vault.vault.azure.net","name":"billing-api-key"}]}
# Default: {} (Azure Key Vault secret provider disabled)
CONNECTION_AZURE_PROVIDER={}

# Optional read-only AWS Secrets Manager secret provider. Profiles fix a
# region-independent identity (web_identity or static_keys plus an explicit STS
# endpoint); aliases map opaque IDs to complete secret ARNs. The regional
# endpoint is derived from each alias ARN; add the STS host and every
# secretsmanager.<region>.amazonaws.com host to EGRESS_ALLOWED_HOSTS.
# AWS aliases are resolved asynchronously at request time and are validated on
# first use, not at startup. Alias IDs share one namespace with operator
# aliases, encrypted-local secrets, and other network providers; duplicate
# alias IDs are rejected at startup. Profile IDs must be unique within this
# provider.
# sts_endpoint is required by web_identity, the only mode that contacts STS;
# static_keys signs directly with its bootstrap key pair and may omit it.
# Secret ARNs must use the aws or aws-us-gov partition, and the partition must
# agree with the region. Pinning the AWSPREVIOUS stage is rejected; pin a
# version_id to roll back.
# Maximum: 8 profiles, 512 aliases. Configuration Debug and errors redact ARNs,
# endpoints, role ARNs, token paths, JSON member names, and all auth locators.
# Example shape:
# CONNECTION_AWS_PROVIDER={"profiles":[{"id":"prod","sts_endpoint":"https://sts.us-east-1.amazonaws.com","auth":{"type":"web_identity","role_arn":"arn:aws:iam::123456789012:role/greengateway-secrets-read","token_root":"/var/run/secrets/eks.amazonaws.com/serviceaccount","token_file":"token"}}],"aliases":[{"id":"billing-key","label":"Billing API key","profile":"prod","arn":"arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/billing-AbCdEf"}]}
# Default: {} (AWS Secrets Manager secret provider disabled)
CONNECTION_AWS_PROVIDER={}

# Explicit opt-in for sampled request-shape capture into DISCOVERY_SQLITE_PATH
# (required alongside it in sqlite mode) or, in postgres mode, into the shared
# discovery tables the projector writes.
# Default: false
PAYLOAD_CAPTURE_ENABLED=false

# Deterministic per-request payload capture sample rate. Must be >= 0.0 and < 1.0.
# Default: 0.10
PAYLOAD_CAPTURE_SAMPLE_RATE=0.10

# Cumulative schema mismatch count that opens a schema_mismatch discovery signal.
# Default: 5
SCHEMA_MISMATCH_SIGNAL_THRESHOLD=5

# Error-rate delta, as a ratio, that opens an error_rate_spike discovery signal.
# Default: 0.40
ERROR_RATE_SPIKE_SIGNAL_THRESHOLD=0.40

# Prior distinct principal count required before a new principal/endpoint pair opens a signal.
# Default: 1
PRINCIPAL_NEW_TO_ENDPOINT_SIGNAL_THRESHOLD=1

# Per-endpoint volume multiple that opens a volume_outlier discovery signal.
# Default: 3.0
VOLUME_OUTLIER_SIGNAL_THRESHOLD=3.0

# Lookback window used by explicit rule suggestion generation for baseline allow candidates.
# Default: 24
RULE_SUGGESTION_BASELINE_WINDOW_HOURS=24

# Optional local OpenAPI 3.x JSON or YAML spec for the legacy single UPSTREAM_URL mode.
# Default: empty (schema coverage disabled unless UPSTREAM_ROUTES entries set openapi_spec_path)
OPENAPI_SPEC_PATH=

# Optional RBAC policy JSON file loaded by authorization middleware.
# Default: empty (RBAC disabled)
POLICY_FILE=

# Optional tool definition registry JSON file. Leave empty to disable dynamic tools.
# Default: empty (tool registry disabled)
TOOLS_FILE=

# Optional upstream MCP servers to discover and proxy as namespaced tools.
# JSON array entries require name and url; optional timeout_ms, response_idle_timeout_ms, and connect_timeout_ms override egress defaults for that MCP server.
# Upstream MCP hosts must still be allowed by EGRESS_ALLOWED_HOSTS or policy egress hosts; they are not auto-seeded.
# Example: [{"name":"prod","url":"https://mcp.example.test/mcp","timeout_ms":5000}]
# Default: empty
MCP_UPSTREAM_SERVERS=

# Optional SQLite policy version history store.
# Default: empty (derive POLICY_FILE.history.sqlite when POLICY_FILE is set)
POLICY_HISTORY_SQLITE_PATH=

# Comma-separated paths exempt from RBAC authorization.
# Default (when unset): /health,/livez,/startupz,/readyz,/version,/metrics plus the effective ADMIN_PREFIX;
# when ADMIN_LOGIN_PROVIDER is set, also /v1{ADMIN_PREFIX}/auth/login and /v1{ADMIN_PREFIX}/auth/callback.
# Leave this UNSET to track ADMIN_PREFIX automatically. Setting it REPLACES the default entirely,
# so update explicit values whenever ADMIN_PREFIX changes; a stale former prefix bypasses RBAC and can be proxied upstream.
# One exception: while ADMIN_LOGIN_PROVIDER is set, /v1{ADMIN_PREFIX}/auth/login and /v1{ADMIN_PREFIX}/auth/callback
# remain exempt even when this variable is set explicitly, because the OIDC authorization-code flow needs them anonymous.
#RBAC_EXEMPT_PATHS=/health,/livez,/startupz,/readyz,/version,/metrics

# Comma-separated CORS origins allowed to read gateway responses.
# Default: empty (no cross-origin browser access allowed)
CORS_ALLOW_ORIGINS=

# Maximum request body size accepted from Content-Length, in bytes.
# Default: 1048576 (1 MiB)
MAX_BODY_SIZE=1048576

# Read-lane token refill rate for GET and HEAD requests, in requests per second.
# Default: 50.0
RATE_LIMIT_READ_RPS=50.0

# Read-lane token bucket burst size for GET and HEAD requests.
# Default: 100
RATE_LIMIT_READ_BURST=100

# Write-lane token refill rate for non-GET/HEAD requests, in requests per second.
# Default: 10.0
RATE_LIMIT_WRITE_RPS=10.0

# Write-lane token bucket burst size for non-GET/HEAD requests.
# Default: 20
RATE_LIMIT_WRITE_BURST=20

# Hard ceiling on distinct tracked rate-limit keys, per limiter (the read lane, the write lane, and each policy rate-limit rule). At the ceiling, idle buckets are recycled first, so a spray of throwaway identities cannot grow memory; a working set larger than the ceiling recycles callers, which resets their burst. Watch rate_limit_buckets and rate_limit_bucket_evictions_total to size it.
# Default: 65536
RATE_LIMIT_MAX_BUCKETS=65536

# How long a rate-limit bucket may sit idle before it is preferred for eviction, in milliseconds. Memory is bounded by RATE_LIMIT_MAX_BUCKETS regardless; this only chooses which bucket is recycled when the ceiling is reached.
# Default: 600000 (10 minutes)
RATE_LIMIT_BUCKET_TTL_MS=600000

# Allow trusted direct proxy peers to supply X-Forwarded-For or X-Real-IP.
# Default: false
TRUST_PROXY_HEADERS=false

# Comma-separated CIDRs for direct proxy peers whose forwarding headers are trusted.
# Required when TRUST_PROXY_HEADERS=true. Default: empty
TRUSTED_PROXY_CIDRS=

# Comma-separated Content-Type prefixes accepted for POST, PUT, and PATCH requests.
# Default: application/json
VALIDATION_ALLOWED_CONTENT_TYPES=application/json

# Enable global authentication middleware.
# Default: true
AUTH_ENABLED=true

# Authentication enforcement mode: required or observe.
# Default: required
AUTH_MODE=required

# Session cookie name used as an auth credential.
# Default: session
AUTH_COOKIE_NAME=session

# Comma-separated paths exempt from authentication.
# Default (when unset): /health,/livez,/startupz,/readyz,/version,/metrics plus the effective ADMIN_PREFIX;
# when ADMIN_LOGIN_PROVIDER is set, also /v1{ADMIN_PREFIX}/auth/login and /v1{ADMIN_PREFIX}/auth/callback.
# Leave this UNSET to track ADMIN_PREFIX automatically. Setting it REPLACES the default entirely,
# so update explicit values whenever ADMIN_PREFIX changes; a stale former prefix bypasses authentication and can be proxied upstream.
# One exception: while ADMIN_LOGIN_PROVIDER is set, /v1{ADMIN_PREFIX}/auth/login and /v1{ADMIN_PREFIX}/auth/callback
# remain exempt even when this variable is set explicitly, because the OIDC authorization-code flow needs them anonymous.
#AUTH_EXEMPT_PATHS=/health,/livez,/startupz,/readyz,/version,/metrics

# Ordered JSON array of auth providers. When empty, the legacy JWT_* settings below are used as an implicit single provider if JWT_JWKS_URL is set.
# Provider types: jwt or cookie_session.
# JWT providers must set jwks_url or issuer. When jwks_url is omitted, issuer is used for OIDC discovery at {issuer}/.well-known/openid-configuration.
# A jwt provider selected by ADMIN_LOGIN_PROVIDER must also set client_id, client_secret, and redirect_uri; its discovery document must include authorization_endpoint and token_endpoint.
# cookie_session providers must set introspection_url and user_id_claim. GreenGateway POSTs {"session":"<cookie value>"} and maps the JSON response with the claim fields below.
# Provider endpoint hosts, including an ADMIN_LOGIN_PROVIDER's discovered token_endpoint host, are added to the effective egress allowlist; non-global-IP and scheme checks still apply.
# roles_claim, org_claim, user_id_claim, and email_claim first resolve exact top-level keys, then fall back to dotted nested paths when no exact key exists.
# roles_claim_delimiter splits string role claims such as scope="read write"; arrays ignore the delimiter. org_claim maps a string claim to Principal.org_id.
# Example: [{"name":"primary","type":"jwt","issuer":"https://idp.example.com","audience":"greengateway","roles_claim":"roles","require_jti":false}]
# Admin UI SSO example: set ADMIN_LOGIN_PROVIDER=primary and add {"client_id":"greengateway-admin","client_secret":"placeholder-secret","redirect_uri":"https://gateway.example.com/v1/admin/auth/callback"} to that jwt provider.
# Nested roles example: [{"name":"keycloak","type":"jwt","issuer":"https://keycloak.example.com/realms/acme","audience":"greengateway","roles_claim":"realm_access.roles","org_claim":"tenant.id"}]
# Scope roles example: [{"name":"oauth","type":"jwt","issuer":"https://idp.example.com","audience":"greengateway","roles_claim":"scope","roles_claim_delimiter":" "}]
# Namespaced literal claim example: [{"name":"auth0","type":"jwt","issuer":"https://tenant.auth0.com/","audience":"https://api.example.com","roles_claim":"https://myapp.example.com/roles","org_claim":"https://myapp.example.com/org_id"}]
# Cookie session example: [{"name":"app","type":"cookie_session","introspection_url":"https://app.example.com/session/introspect","user_id_claim":"account.id","email_claim":"account.email","roles_claim":"account.scope","roles_claim_delimiter":" ","org_claim":"account.tenant_id","cache_ttl_ms":5000}]
# Default: empty
AUTH_PROVIDERS=

# Optional JWKS endpoint used to validate bearer JWTs.
# Default: empty (JWT validator disabled)
JWT_JWKS_URL=

# Optional expected JWT issuer.
# Default: empty (issuer is not checked)
JWT_ISSUER=

# Optional expected JWT audience.
# Default: empty (audience is not checked)
JWT_AUDIENCE=

# Timeout for JWKS fetches, in milliseconds.
# Default: 2000
JWT_JWKS_TIMEOUT_MS=2000

# How long a fetched JWKS key set stays trusted, in seconds (10-86400; the floor is the demand-refresh throttle). Keys are refreshed in the background at half this age; past it a request refreshes first or fails closed.
# Default: 300
JWT_JWKS_MAX_KEY_AGE_SECS=300

# Require bearer JWTs to include a non-empty jti claim.
# Default: false
JWT_REQUIRE_JTI=false

# JWT role claim key or dotted path. Exact top-level keys win before dotted path fallback, so Auth0-style URL claim keys remain literal.
# Legacy ROLES_CLAIM extracts arrays of strings only; use AUTH_PROVIDERS roles_claim_delimiter for string scope claims.
# Default: roles
ROLES_CLAIM=roles

# Optional SQLite store path for service tokens created by the admin API and accepted as ggw_ bearer credentials.
# Default: empty (service-token API and validator disabled)
SERVICE_TOKEN_SQLITE_PATH=

# Service-token verification cache TTL, in milliseconds. Revocations made outside this process can remain accepted until this window expires.
# Default: 5000
SERVICE_TOKEN_CACHE_TTL_MS=5000

# Maximum queued plus running tool invocations admitted by the generic tool runtime.
# Default: 1024
TOOL_RUNTIME_QUEUE_DEPTH=1024

# Maximum concurrently executing tool invocations across all tools.
# Default: 64
TOOL_RUNTIME_GLOBAL_CONCURRENCY=64

# Maximum time a queued tool invocation waits for execution permits, in milliseconds.
# Default: 1000
TOOL_RUNTIME_QUEUE_TIMEOUT_MS=1000

# Cluster mode only: how long an execution lease (a slot of the cluster-wide global or per-tool concurrency limit) lives on the database clock before an unrenewed slot is reclaimable, in milliseconds. Renewed at a third of this; at least 1000.
# Default: 15000
TOOL_LEASE_TTL_MS=15000

# Default execution timeout for generic tool runtime invocations, in milliseconds.
# Default: 30000
TOOL_RUNTIME_DEFAULT_TIMEOUT_MS=30000

# Enable double-submit CSRF checks for gateway control-plane state-changing requests.
# Default: true
CSRF_ENABLED=true

# CSRF token cookie name. This cookie is intentionally readable by browser JavaScript.
# Default: csrf_token
CSRF_COOKIE_NAME=csrf_token

# Request header that must echo the CSRF cookie token for protected state-changing requests.
# Default: x-csrf-token
CSRF_HEADER_NAME=x-csrf-token

# Optional Domain attribute for the CSRF cookie. Leave empty to omit Domain.
# Default: empty
CSRF_COOKIE_DOMAIN=

# Comma-separated paths exempt from CSRF checks.
# Default: /health,/livez,/startupz,/readyz,/version,/metrics
CSRF_EXEMPT_PATHS=/health,/livez,/startupz,/readyz,/version,/metrics

# Optional upstream origin for catch-all reverse proxy fallback. Leave empty to disable proxying.
# Default: empty
UPSTREAM_URL=

# Optional ordered routing table as a JSON array. Mutually exclusive with UPSTREAM_URL.
# Pooled route entries may also configure bounded health checks, request body mode,
# admission limits, explicit SSE streaming, replay-safe retry policy, and
# per-endpoint circuit breakers. Pooled endpoints may reference mounted PEM
# client identities with client_identity_pem_path; inline private keys are unsupported.
# Retries default to one total attempt and circuit breaking is disabled when omitted.
# Route entries may include timeout_ms, response_idle_timeout_ms, connect_timeout_ms,
# sse, add_request_headers, strip_request_headers, tls_ca_bundle_path, and
# openapi_spec_path. SSE defaults to a one-hour duration and the global response
# byte limit; zero explicitly allows unlimited duration or bytes while idle and
# concurrency limits remain enforced.
# Example: [{"path_prefix":"/api","upstream_url":"https://api.example.test","timeout_ms":1500,"add_request_headers":{"x-gateway-upstream":"api"},"strip_request_headers":["x-client-secret"],"tls_ca_bundle_path":"/etc/greengateway/internal-ca.pem","openapi_spec_path":"/etc/greengateway/api.openapi.yaml"},{"path_prefix":"/events","upstream_url":"https://events.example.test","timeout_ms":5000,"response_idle_timeout_ms":45000,"sse":{"max_duration_ms":3600000,"max_response_bytes":0}},{"id":"payments","path_prefix":"/payments","upstreams":[{"id":"payments-a","url":"https://payments-a.example.test","tls_ca_bundle_path":"/run/secrets/payments-ca.pem","client_identity_pem_path":"/run/secrets/payments-client.pem"}]}]
# Default: empty
UPSTREAM_ROUTES=

# Optional total timeout override for configured upstream proxy requests, in milliseconds.
# Default: empty (inherits EGRESS_TIMEOUT_MS)
# Must be greater than 0; 0 is rejected at startup because a zero timeout fails every request as a timeout.
UPSTREAM_TIMEOUT_MS=

# Optional streamed response idle timeout override for configured upstream proxy requests, in milliseconds.
# Default: empty (inherits EGRESS_RESPONSE_IDLE_TIMEOUT_MS)
# Must be greater than 0; 0 is rejected at startup because a zero timeout fails every request as a timeout.
UPSTREAM_RESPONSE_IDLE_TIMEOUT_MS=

# Optional TCP/TLS connection timeout override for configured upstream proxy requests, in milliseconds.
# Default: empty (inherits EGRESS_CONNECT_TIMEOUT_MS)
# Must be greater than 0; 0 is rejected at startup because a zero timeout fails every request as a timeout.
UPSTREAM_CONNECT_TIMEOUT_MS=

# Comma-separated outbound hostnames the egress client may call. Empty denies all.
# Default: empty (deny all gateway-originated outbound HTTP)
EGRESS_ALLOWED_HOSTS=

# Total timeout for each egress HTTP request, in milliseconds.
# Default: 30000
# Must be greater than 0; 0 is rejected at startup because a zero timeout fails every request as a timeout.
EGRESS_TIMEOUT_MS=30000

# Idle timeout between streamed egress response body chunks, in milliseconds.
# Default: 30000
# Must be greater than 0; 0 is rejected at startup because a zero timeout fails every request as a timeout.
EGRESS_RESPONSE_IDLE_TIMEOUT_MS=30000

# TCP/TLS connection timeout for each egress HTTP request, in milliseconds.
# Default: 10000
# Must be greater than 0; 0 is rejected at startup because a zero timeout fails every request as a timeout.
EGRESS_CONNECT_TIMEOUT_MS=10000

# Maximum egress response body bytes buffered while streaming.
# Default: 5242880 (5 MiB)
EGRESS_MAX_RESPONSE_BYTES=5242880

# Maximum egress request body bytes allowed before send.
# Default: 1048576 (1 MiB)
EGRESS_MAX_REQUEST_BODY_BYTES=1048576

# Optional RFC 6052 network-specific NAT64 prefixes. The well-known 64:ff9b::/96 prefix is built in.
# Allowed prefix lengths: 32, 40, 48, 56, 64, or 96. The RFC 6052 u octet must be zero.
# Prefixes must not overlap each other or the built-in well-known prefix.
# Default: empty
EGRESS_NAT64_PREFIXES=

# Block non-global and special-use resolved IPs, including private, loopback, link-local, CGNAT, documentation, benchmarking, multicast, and reserved ranges.
# Default: true
EGRESS_DENY_PRIVATE_IPS=true

# Which store owns shared mutable state: `sqlite` (one gateway process, fully
# supported standalone mode -- the default and today's behavior) or `postgres`
# (experimental cluster mode; requires DEPLOYMENT_ID and DATABASE_URL_FILE, and
# rejects every writable local store). Mode is a startup-time setting and part
# of the security-configuration fingerprint: two replicas of one deployment
# must agree on it. Cluster mode is not a supported HA configuration until the
# #241 release gate passes; see docs/deployment/postgres.md.
# Default: sqlite
STATE_BACKEND=sqlite

# Stable, non-secret identifier scoping every authoritative row, lock, lease,
# and notification of one logical deployment. Required in postgres mode,
# rejected in sqlite mode. 1 to 64 bytes of ASCII letters, digits, '.', '_', or
# '-', starting and ending with a letter or digit. It appears in logs and
# status by design, which is why its shape is pinned.
# Default: empty (unused in standalone mode)
DEPLOYMENT_ID=

# Path to the file containing the PostgreSQL connection string (a
# postgresql:// URL; its query parameters may only be user, password, host,
# port, dbname, and application_name -- TLS policy and session timeouts come
# from this gateway's settings, never from the DSN). The file is read through
# a bounded, permission-checked reader: it must be a regular file granting no
# group or other permission at all (a Kubernetes Secret volume needs
# defaultMode: 0400), and its contents never enter configuration, logs,
# metrics, status, or errors. Required in postgres mode, rejected in sqlite
# mode.
# Default: empty (unused in standalone mode)
DATABASE_URL_FILE=

# TLS policy for PostgreSQL connections. `verify` (the default) requires TLS
# with certificate and hostname verification against the platform trust store
# plus the optional DATABASE_TLS_CA_FILE bundle; a server that will not speak
# TLS fails the connection. `loopback-dev` skips TLS entirely and is refused
# for any target that is not loopback or a Unix socket, so the exception
# cannot quietly become a production plaintext connection.
# Default: verify
DATABASE_TLS_MODE=verify

# Optional PEM bundle of extra trust anchors for PostgreSQL server-certificate
# verification, layered on top of the platform trust store exactly as egress
# TLS layers a configured CA. Public material: it must not be writable by
# group or other. Only read in postgres mode with DATABASE_TLS_MODE=verify.
# Default: empty (platform trust store only)
DATABASE_TLS_CA_FILE=

# Per-replica PostgreSQL connection pool ceiling. Documented sizing math:
# replicas x DATABASE_POOL_MAX + migrator/leader headroom must stay within the
# server's max_connections. Must be between 1 and 256.
# Default: 10
DATABASE_POOL_MAX=10

# Bound on establishing one new PostgreSQL connection, in milliseconds.
# Must be greater than 0.
# Default: 5000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Bound on checking a connection out of the pool, in milliseconds.
# Must be greater than 0.
# Default: 5000
DATABASE_ACQUIRE_TIMEOUT_MS=5000

# Server-side statement_timeout applied to every pooled PostgreSQL session, in
# milliseconds. Applied as a startup parameter, so no code path can SET it
# back. Must be greater than 0.
# Default: 15000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Server-side idle_in_transaction_session_timeout applied to every pooled
# PostgreSQL session, in milliseconds. Must be greater than 0.
# Default: 30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Server-side lock_timeout applied to every pooled PostgreSQL session, in
# milliseconds. Must be greater than 0.
# Default: 5000
DATABASE_LOCK_TIMEOUT_MS=5000

# Bounded startup policy: retries after the first failed connectivity attempt
# before startup fails, waiting 250 ms initially and doubling up to 8 s. 0
# fails startup on the first failure. Must be at most 300.
# Default: 5
DATABASE_STARTUP_RETRY_LIMIT=5

# Development-only auto-migration: when true, a serving process in postgres
# mode applies pending schema migrations at startup, exactly as
# `gateway migrate up` would. Production pods validate only -- the default --
# with migrations owned by a separate job using the DDL-capable migration
# role. Rejected in sqlite mode.
# Default: false
DATABASE_AUTO_MIGRATE=false

# Bound, in milliseconds, on each statement and lock wait inside a migration
# transaction (`gateway migrate up`, and auto-migration when enabled).
# Applied with SET LOCAL, so it never leaks into pooled sessions. Deliberately
# wider than the request-path statement timeout: real DDL takes longer than a
# lookup, and still finite. Must be greater than 0 and at most 600000.
# Default: 60000
DATABASE_MIGRATION_STATEMENT_TIMEOUT_MS=60000

# How often, in milliseconds, a postgres-mode replica refreshes its row in the
# deployment's membership roster (greengateway.cluster_members) with its
# identity, static-configuration fingerprint, compatibility ranges, and the
# security revisions it has compiled and last observed. Cluster mode only; a
# value is rejected in sqlite mode (blank is unset). Must be at least 1000.
# Default: 5000
CLUSTER_HEARTBEAT_MS=

# How old a member's heartbeat may be, in milliseconds, before its roster row
# is stale: ignored by the fingerprint-agreement readiness check and swept by
# the maintenance singleton (never by request handling). Must be at least
# 3 x CLUSTER_HEARTBEAT_MS so one slow authority round trip never makes a live
# replica look gone. Cluster mode only; a value is rejected in sqlite mode
# (blank is unset).
# Default: 30000
CLUSTER_MEMBER_STALE_MS=

# How often, in milliseconds, the replica holding the maintenance lease runs
# one bounded pass of the singleton housekeeping jobs (JWT revocation cleanup,
# rate-limit idle sweep, pending-login prune, stale member sweep, audit
# retention, execution-lease reaping). Replicas without the lease retry it
# with a jittered backoff of a quarter of this interval, plus or minus up to
# an eighth. Cluster mode only; a value is rejected in sqlite mode (blank is
# unset). Must be at least 1000.
# Default: 60000
CLUSTER_MAINTENANCE_INTERVAL_MS=

# How long the maintenance lease (greengateway.execution_leases, scope
# 'maintenance') lives on the database clock before an unrenewed slot can be
# taken over, in milliseconds. Renewed at a third of this; the leader stops its
# jobs on the first failed renewal, before the slot can be reclaimed. Cluster
# mode only; a value is rejected in sqlite mode (blank is unset). Must be at
# least 1000.
# Default: 15000
CLUSTER_MAINTENANCE_LEASE_TTL_MS=

# Retention window, in days, for the PostgreSQL audit store
# (greengateway.audit_events). The maintenance leader deletes a bounded batch
# of the oldest events past the window on each pass, never past the position a
# durable stream consumer has yet to apply. Empty or 0 keeps everything. Cluster
# mode only; a value is rejected in sqlite mode (use AUDIT_SQLITE_RETENTION_DAYS
# there; blank is unset). Must be at most 36500.
# Default: (empty)
AUDIT_POSTGRES_RETENTION_DAYS=

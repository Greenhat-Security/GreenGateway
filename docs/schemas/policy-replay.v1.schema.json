{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/policy-replay.v1.schema.json",
  "title": "GreenGateway policy replay request",
  "description": "Draft 2020-12 JSON Schema for a policy-replay.v1 request, which starts a bounded historical replay job: a pinned base ETag, a candidate (the active policy, position-aware edits over it, or an inline policy document, with the members a policy-simulation.v1 candidate has), a window of audit timestamps, an optional record bound and an optional idempotency key. The gateway's parser is authoritative and also enforces what JSON Schema cannot state here: that the window's bounds are RFC 3339 date-times with an offset, that the window begins before it ends, ends no later than the job's creation and covers at most 31 days, byte (not character) limits, and that an edit's position exists. Whether a candidate is a valid policy is the policy validator's answer. Unknown members are refused everywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_etag",
    "candidate",
    "window"
  ],
  "properties": {
    "schema_version": {
      "const": "policy-replay.v1"
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "base_etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "to": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "active"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "edits"
          ],
          "properties": {
            "source": {
              "const": "edits"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/edit"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "policy"
          ],
          "properties": {
            "source": {
              "const": "inline"
            },
            "policy": {
              "type": "object"
            }
          }
        }
      ]
    },
    "edit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "section",
            "position",
            "value"
          ],
          "properties": {
            "op": {
              "const": "insert"
            },
            "section": {
              "$ref": "#/$defs/section"
            },
            "position": {
              "$ref": "#/$defs/position"
            },
            "value": {
              "$ref": "#/$defs/element"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "section",
            "position",
            "value"
          ],
          "properties": {
            "op": {
              "const": "replace"
            },
            "section": {
              "$ref": "#/$defs/section"
            },
            "position": {
              "$ref": "#/$defs/position"
            },
            "expect_id": {
              "$ref": "#/$defs/element_id"
            },
            "value": {
              "$ref": "#/$defs/element"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "section",
            "from",
            "to"
          ],
          "properties": {
            "op": {
              "const": "move"
            },
            "section": {
              "$ref": "#/$defs/section"
            },
            "from": {
              "$ref": "#/$defs/position"
            },
            "to": {
              "$ref": "#/$defs/position"
            },
            "expect_id": {
              "$ref": "#/$defs/element_id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "section",
            "position"
          ],
          "properties": {
            "op": {
              "const": "delete"
            },
            "section": {
              "$ref": "#/$defs/section"
            },
            "position": {
              "$ref": "#/$defs/position"
            },
            "expect_id": {
              "$ref": "#/$defs/element_id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "field": {
              "const": "default_action"
            },
            "value": {
              "enum": [
                "allow",
                "deny"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "field": {
              "const": "enforcement_mode"
            },
            "value": {
              "enum": [
                "enforce",
                "shadow"
              ]
            }
          }
        }
      ]
    },
    "element": {
      "type": "object"
    },
    "element_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "section": {
      "enum": [
        "rules",
        "routes",
        "rate_limits"
      ]
    }
  }
}

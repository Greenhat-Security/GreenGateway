{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/ggctl-report.v1alpha1.schema.json",
  "title": "ggctl Report",
  "description": "The one document ggctl writes to standard output with --format json, for every command that does not write an artifact. exitCode and outcome are the process exit status and its stable name. Diagnostics are value-free: a stable family.reason code, fixed message text, an optional fixed hint, a documentation anchor, and at most one location: the 1-based position of the command-line argument concerned, or a bundle-relative file name with a JSON Pointer built from member names the bundle reader defines and a 1-based line and column; never an argument, token, URL, path, document value, server response, or library error. A published diagnostic code never changes meaning; renaming or removing one requires a new report version. An argument error found before a command runs writes no report (exit 2, standard error only).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "command", "exitCode", "outcome", "diagnostics", "result"],
  "properties": {
    "apiVersion": {
      "description": "Exact document version. No other version, prefix, or spelling is accepted.",
      "const": "greengateway.dev/v1alpha1"
    },
    "kind": {
      "const": "GgctlReport"
    },
    "command": {
      "enum": ["version", "schema", "validate", "doctor"]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "outcome": {
      "enum": ["success", "failure", "usage", "invalid", "drift", "conflict", "unavailable", "integrity", "denied"]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "result": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"command": {"const": "version"}}
      },
      "then": {
        "properties": {"result": {"$ref": "#/$defs/versionResult"}}
      }
    },
    {
      "if": {
        "properties": {"command": {"const": "schema"}}
      },
      "then": {
        "properties": {"result": {"$ref": "#/$defs/schemaResult"}}
      }
    },
    {
      "if": {
        "properties": {"command": {"const": "validate"}}
      },
      "then": {
        "properties": {"result": {"$ref": "#/$defs/validateResult"}}
      }
    },
    {
      "if": {
        "properties": {"command": {"const": "doctor"}}
      },
      "then": {
        "properties": {"result": {"$ref": "#/$defs/doctorResult"}}
      }
    }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "remediation"],
      "properties": {
        "code": {
          "description": "The stable family.reason code. docs/ggctl.md lists every ggctl code by family, and docs/configuration-bundles.md every bundle reader code.",
          "type": "string",
          "pattern": "^(usage|credential|trust|remote|compat|schema|validate|doctor|output|internal|bundle|syntax|json|yaml|reference|secret|resource|profile)\\.[a-z][a-z0-9_]*$"
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "message": {
          "description": "Fixed text chosen by the code.",
          "type": "string"
        },
        "hint": {
          "description": "Fixed guidance chosen by ggctl, never derived from input.",
          "type": "string"
        },
        "remediation": {
          "description": "A repository documentation anchor.",
          "type": "string",
          "pattern": "^docs/(ggctl\\.md#[a-z]+-diagnostics|configuration-bundles\\.md#diagnostics)$"
        },
        "location": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument"],
              "properties": {
                "argument": {
                  "description": "The 1-based position of the command-line argument after ggctl.",
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "pointer"],
              "dependentRequired": {"line": ["column"], "column": ["line"]},
              "properties": {
                "file": {
                  "description": "The bundle-relative name of the file concerned; it passed the portable file-name grammar.",
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
                },
                "pointer": {
                  "description": "An RFC 6901 JSON Pointer into the file's document, built from member names the reader defines and array indices; empty for the document as a whole.",
                  "type": "string",
                  "pattern": "^(/([^/~]|~[01])*)*$"
                },
                "line": {"type": "integer", "minimum": 1},
                "column": {
                  "description": "1-based, counted in Unicode scalar values.",
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "documentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind"],
      "properties": {
        "apiVersion": {"type": "string"},
        "kind": {"type": "string"}
      }
    },
    "versionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "schemas"],
      "properties": {
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "ggctl"},
            "version": {"type": "string"}
          }
        },
        "schemas": {
          "description": "The document versions this ggctl publishes schemas for.",
          "type": "array",
          "items": {"$ref": "#/$defs/documentVersion"}
        },
        "server": {
          "description": "Present only with --server. compatible is true only when the server's capability document was read and is one this ggctl implements; gatewayVersion appears when the server stated a well-formed one, and capabilities only when compatible.",
          "type": "object",
          "additionalProperties": false,
          "required": ["compatible"],
          "properties": {
            "compatible": {"type": "boolean"},
            "gatewayVersion": {"type": "string"},
            "capabilities": {
              "description": "The server's GatewayCapabilities document as ggctl read it; gateway-capabilities.v1alpha1.schema.json is its schema.",
              "type": "object"
            }
          }
        }
      }
    },
    "validateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": {
          "description": "No stage of the bundle reader found an error. The gateway's production policy and tools validators are not part of ggctl and did not run; a warning under --warnings-as-errors changes the exit code, not this.",
          "type": "boolean"
        },
        "bundle": {"$ref": "#/$defs/bundle"}
      }
    },
    "doctorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "bundle": {"$ref": "#/$defs/bundle"},
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/check"}
        }
      }
    },
    "bundle": {
      "description": "What the bundle's manifest declares, present once the manifest was read. sourceDigest, the deployment's sha256 and profile, and each bundled resource's sha256 appear only when every stage passed. Names, versions, and digests only; never document content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "name", "deployment"],
      "properties": {
        "apiVersion": {"const": "greengateway.dev/v1alpha1"},
        "name": {"type": "string"},
        "sourceDigest": {
          "description": "An integrity value over the framed manifest bytes, not a signature.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {"type": "string"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "profile": {"enum": ["production", "migration", "development"]}
          }
        },
        "policy": {"$ref": "#/$defs/resource"},
        "tools": {"$ref": "#/$defs/resource"},
        "connections": {"const": "server"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"enum": ["bundle", "server"]},
        "file": {"type": "string"},
        "schemaVersion": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "productionValidator": {
          "description": "For a document the bundle supplies: the gateway's production validator is not part of ggctl and did not run.",
          "const": "not_run"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "check": {
      "description": "One offline doctor check. severity is error for a required check, whose failure fails the doctor, and warning for advice; skipped never counts as pass. reason is a bundle reader code or a doctor reason. docs/ggctl.md lists every check and reason.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "reason", "remediation", "durationMs"],
      "properties": {
        "id": {
          "enum": [
            "bundle.files",
            "bundle.syntax",
            "bundle.compatibility",
            "bundle.structure",
            "bundle.references",
            "bundle.resources",
            "bundle.profile",
            "bundle.unreferenced_entries",
            "resources.production_validators",
            "deployment.profile"
          ]
        },
        "severity": {"enum": ["error", "warning"]},
        "status": {"enum": ["pass", "warning", "fail", "skipped"]},
        "reason": {
          "type": "string",
          "pattern": "^(doctor|bundle|syntax|json|yaml|compat|schema|reference|secret|resource|profile)\\.[a-z][a-z0-9_]*$"
        },
        "remediation": {"enum": ["docs/ggctl.md#doctor-checks", "docs/configuration-bundles.md#diagnostics"]},
        "durationMs": {
          "description": "Checks drawn from the one bundle reader run report that run's duration.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schemaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemas"],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {"$ref": "#/$defs/documentVersion"}
        }
      }
    }
  }
}

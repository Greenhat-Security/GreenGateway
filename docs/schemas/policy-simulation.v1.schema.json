{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/policy-simulation.v1.schema.json",
  "title": "GreenGateway policy simulation request",
  "description": "Draft 2020-12 JSON Schema for a policy-simulation.v1 request: a pinned base ETag, a candidate (the active policy, position-aware edits over it, or an inline policy document), a trace level, projections and synthetic cases. Cases are policy-tests.v1 cases without expect. The gateway's parser is authoritative and also enforces what JSON Schema cannot state here: path, host and origin syntax, principal shape bounds, unique case ids, byte (not character) limits, and that an edit's position exists. Whether a candidate is a valid policy is the policy validator's answer. Unknown members are refused everywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_etag", "candidate", "cases"],
  "properties": {
    "schema_version": {"const": "policy-simulation.v1"},
    "description": {"$ref": "#/$defs/description"},
    "base_etag": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate": {"$ref": "#/$defs/candidate"},
    "trace": {"enum": ["terminal", "matched", "full"]},
    "projections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["as_authored", "enforce_all_shadow"]}
    },
    "cases": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "case_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "method": {"type": "string", "minLength": 1, "maxLength": 64},
    "path": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^/"},
    "host": {"type": "string", "minLength": 1, "maxLength": 4096},
    "dispatch_fact": {"type": "string", "minLength": 1, "maxLength": 4096},
    "tool_name": {"type": "string", "minLength": 1, "maxLength": 4096},
    "position": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "principal": {
      "oneOf": [
        {"const": "anonymous"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "auth_method"],
          "properties": {
            "subject": {"type": "string", "minLength": 1, "maxLength": 4096},
            "issuer": {"type": "string", "minLength": 1, "maxLength": 4096},
            "roles": {
              "type": "array",
              "maxItems": 256,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "auth_method": {
              "enum": ["bearer_token", "session_cookie", "service_token", "client_certificate"]
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "contextless"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "canonical_path"],
          "properties": {"kind": {"const": "mcp_alias"}, "canonical_path": {"$ref": "#/$defs/path"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "upstream_origin"],
          "properties": {
            "kind": {"const": "proxy_dispatch"},
            "upstream_origin": {"$ref": "#/$defs/dispatch_fact"},
            "route_id": {"$ref": "#/$defs/dispatch_fact"},
            "route_host": {"$ref": "#/$defs/host"},
            "route_path_prefix": {"$ref": "#/$defs/dispatch_fact"}
          }
        }
      ]
    },
    "http_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"$ref": "#/$defs/method"},
        "path": {"$ref": "#/$defs/path"},
        "host": {"$ref": "#/$defs/host"},
        "target": {"$ref": "#/$defs/target"}
      }
    },
    "method_and_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {"method": {"$ref": "#/$defs/method"}, "path": {"$ref": "#/$defs/path"}}
    },
    "element_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "section": {"enum": ["rules", "routes", "rate_limits"]},
    "element": {"type": "object"},
    "edit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position", "value"],
          "properties": {
            "op": {"const": "insert"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "value": {"$ref": "#/$defs/element"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position", "value"],
          "properties": {
            "op": {"const": "replace"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"},
            "value": {"$ref": "#/$defs/element"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "from", "to"],
          "properties": {
            "op": {"const": "move"},
            "section": {"$ref": "#/$defs/section"},
            "from": {"$ref": "#/$defs/position"},
            "to": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position"],
          "properties": {
            "op": {"const": "delete"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": {"const": "set"},
            "field": {"const": "default_action"},
            "value": {"enum": ["allow", "deny"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": {"const": "set"},
            "field": {"const": "enforcement_mode"},
            "value": {"enum": ["enforce", "shadow"]}
          }
        }
      ]
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {"source": {"const": "active"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "edits"],
          "properties": {
            "source": {"const": "edits"},
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/edit"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "policy"],
          "properties": {"source": {"const": "inline"}, "policy": {"type": "object"}}
        }
      ]
    },
    "case": {
      "type": "object",
      "required": ["id", "kind", "principal"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["request"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "http"},
            "principal": {"$ref": "#/$defs/principal"},
            "request": {"$ref": "#/$defs/http_request"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "tool"},
            "principal": {"$ref": "#/$defs/principal"},
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {"$ref": "#/$defs/tool_name"},
                "operation": {"enum": ["invocation", "visibility", "eligibility"]}
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["tool", "request"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "tool_http"},
            "principal": {"$ref": "#/$defs/principal"},
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {"name": {"$ref": "#/$defs/tool_name"}}
            },
            "request": {"$ref": "#/$defs/method_and_path"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["request"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "rate"},
            "principal": {"$ref": "#/$defs/principal"},
            "request": {"$ref": "#/$defs/method_and_path"}
          }
        }
      ]
    }
  }
}

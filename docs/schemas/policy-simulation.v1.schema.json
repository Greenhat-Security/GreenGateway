{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/policy-simulation.v1.schema.json",
  "title": "GreenGateway policy simulation request",
  "description": "Draft 2020-12 JSON Schema for a policy-simulation.v1 request: a pinned base ETag, a candidate (the active policy, position-aware edits over it, an inline policy document, a server-side draft or a policy history version), a trace level, projections and synthetic cases. Cases are policy-tests.v1 cases without expect. The gateway's parser is authoritative and also enforces what JSON Schema cannot state here: path, host and origin syntax, principal shape bounds, unique case ids, byte (not character) limits, and that an edit's position exists. Whether a candidate is a valid policy is the policy validator's answer. A draft candidate names a server-side draft by its id and its strong draft ETag, and a revision candidate names a policy history version; whether that draft belongs to the caller, is current and is pinned to base_etag, and whether that version exists and is a policy this build accepts, is the gateway's answer when the request is served. Unknown members are refused everywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_etag", "candidate", "cases"],
  "properties": {
    "schema_version": {"const": "policy-simulation.v1"},
    "description": {"$ref": "#/$defs/description"},
    "base_etag": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate": {"$ref": "#/$defs/candidate"},
    "trace": {"enum": ["terminal", "matched", "full"]},
    "projections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["as_authored", "enforce_all_shadow"]}
    },
    "cases": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "case_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "method": {"type": "string", "minLength": 1, "maxLength": 64},
    "path": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^/"},
    "host": {"type": "string", "minLength": 1, "maxLength": 4096},
    "dispatch_fact": {"type": "string", "minLength": 1, "maxLength": 4096},
    "tool_name": {"type": "string", "minLength": 1, "maxLength": 4096},
    "position": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "principal": {
      "oneOf": [
        {"const": "anonymous"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "auth_method"],
          "properties": {
            "subject": {"type": "string", "minLength": 1, "maxLength": 4096},
            "issuer": {"type": "string", "minLength": 1, "maxLength": 4096},
            "roles": {
              "type": "array",
              "maxItems": 256,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "auth_method": {
              "enum": ["bearer_token", "session_cookie", "service_token", "client_certificate"]
            },
            "organization": {
              "description": "The organization authentication verified for the principal, which an identity mapping or an organization condition may test. Omitted, the principal has none, exactly as a principal whose provider verified none. It is read only when a mapping or condition reads it, as on the live lanes.",
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "contextless"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "canonical_path"],
          "properties": {"kind": {"const": "mcp_alias"}, "canonical_path": {"$ref": "#/$defs/path"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "upstream_origin"],
          "properties": {
            "kind": {"const": "proxy_dispatch"},
            "upstream_origin": {"$ref": "#/$defs/dispatch_fact"},
            "route_id": {"$ref": "#/$defs/dispatch_fact"},
            "route_host": {"$ref": "#/$defs/host"},
            "route_path_prefix": {"$ref": "#/$defs/dispatch_fact"}
          }
        }
      ]
    },
    "http_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"$ref": "#/$defs/method"},
        "path": {"$ref": "#/$defs/path"},
        "host": {"$ref": "#/$defs/host"},
        "target": {"$ref": "#/$defs/target"}
      }
    },
    "method_and_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {"method": {"$ref": "#/$defs/method"}, "path": {"$ref": "#/$defs/path"}}
    },
    "element_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "section": {"enum": ["rules", "routes", "rate_limits"]},
    "element": {"type": "object"},
    "edit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position", "value"],
          "properties": {
            "op": {"const": "insert"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "value": {"$ref": "#/$defs/element"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position", "value"],
          "properties": {
            "op": {"const": "replace"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"},
            "value": {"$ref": "#/$defs/element"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "from", "to"],
          "properties": {
            "op": {"const": "move"},
            "section": {"$ref": "#/$defs/section"},
            "from": {"$ref": "#/$defs/position"},
            "to": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "section", "position"],
          "properties": {
            "op": {"const": "delete"},
            "section": {"$ref": "#/$defs/section"},
            "position": {"$ref": "#/$defs/position"},
            "expect_id": {"$ref": "#/$defs/element_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": {"const": "set"},
            "field": {"const": "default_action"},
            "value": {"enum": ["allow", "deny"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "value"],
          "properties": {
            "op": {"const": "set"},
            "field": {"const": "enforcement_mode"},
            "value": {"enum": ["enforce", "shadow"]}
          }
        }
      ]
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {"source": {"const": "active"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "edits"],
          "properties": {
            "source": {"const": "edits"},
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/edit"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "policy"],
          "properties": {"source": {"const": "inline"}, "policy": {"type": "object"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "draft_id", "draft_etag"],
          "properties": {
            "source": {"const": "draft"},
            "draft_id": {"type": "string", "minLength": 1, "maxLength": 64},
            "draft_etag": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "version"],
          "properties": {
            "source": {"const": "revision"},
            "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
          }
        }
      ]
    },
    "fact_values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string", "maxLength": 8192}
    },
    "request_facts": {
      "description": "The request facts an http case states for the rule conditions a policy may carry. A member omitted is a fact the case does not state: a condition that reads it is indeterminate, never a guessed match. An empty headers or query object states a request that carried none. Header names are lowercase; a header or query name that can carry a credential, an identity or hop-by-hop routing is refused (forbidden_field). At most 128 occurrences each.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip": {"$ref": "#/$defs/source_ip"},
        "headers": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z0-9!#$%&'*+.^_`|~-]{1,256}$"},
          "additionalProperties": {"$ref": "#/$defs/fact_values"}
        },
        "query": {
          "type": "object",
          "propertyNames": {"minLength": 1, "maxLength": 256},
          "additionalProperties": {"$ref": "#/$defs/fact_values"}
        },
        "now": {"$ref": "#/$defs/instant"}
      }
    },
    "call_facts": {
      "description": "The facts a tool or tool_http case states: a tool call has a source address and an instant, but no headers or query of its own (fact_not_applicable).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip": {"$ref": "#/$defs/source_ip"},
        "now": {"$ref": "#/$defs/instant"}
      }
    },
    "source_ip": {
      "description": "The canonical client address the gateway derives after trusted-proxy processing: an IPv4 or IPv6 address without a port.",
      "type": "string",
      "minLength": 2,
      "maxLength": 45
    },
    "instant": {
      "description": "The evaluation instant, an RFC 3339 UTC instant written YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "case": {
      "type": "object",
      "required": ["id", "kind", "principal"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["request"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "http"},
            "principal": {"$ref": "#/$defs/principal"},
            "request": {"$ref": "#/$defs/http_request"},
            "facts": {"$ref": "#/$defs/request_facts"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "tool"},
            "principal": {"$ref": "#/$defs/principal"},
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {"$ref": "#/$defs/tool_name"},
                "operation": {"enum": ["invocation", "visibility", "eligibility"]}
              }
            },
            "facts": {"$ref": "#/$defs/call_facts"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["tool", "request"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "tool_http"},
            "principal": {"$ref": "#/$defs/principal"},
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {"name": {"$ref": "#/$defs/tool_name"}}
            },
            "request": {"$ref": "#/$defs/method_and_path"},
            "facts": {"$ref": "#/$defs/call_facts"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["request"],
          "properties": {
            "id": {"$ref": "#/$defs/case_id"},
            "description": {"$ref": "#/$defs/description"},
            "kind": {"const": "rate"},
            "principal": {"$ref": "#/$defs/principal"},
            "request": {"$ref": "#/$defs/method_and_path"}
          }
        }
      ]
    }
  }
}

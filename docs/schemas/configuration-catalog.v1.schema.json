{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/configuration-catalog.v1.schema.json",
  "title": "GreenGateway configuration field catalog",
  "description": "The rendered configuration field catalog (docs/configuration-catalog.json, issue #242). It describes every setting the gateway's configuration compiler reads, in the order the compiler reads them. The catalog in the gateway-config library is the source of this document, and parity tests hold it to the compiler, docs/configuration.md, .env.example, ADR-0008 and the Cloudflare wrapper. The compiler stays authoritative: this document describes it and is never read at startup.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fields"],
  "properties": {
    "schema_version": { "const": "configuration-catalog.v1" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "environment",
        "domain",
        "type",
        "default",
        "blank",
        "sensitivity",
        "disclosure",
        "state_backends",
        "reload",
        "bundle",
        "platforms",
        "documentation"
      ],
      "properties": {
        "id": {
          "description": "The stable field identifier: the environment variable in lower case.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "environment": { "$ref": "#/$defs/variable" },
        "domain": {
          "description": "The configuration compiler plan that holds the field.",
          "enum": ["listeners", "identity", "proxy", "storage", "connections", "egress", "runtime"]
        },
        "type": { "$ref": "#/$defs/type" },
        "default": { "$ref": "#/$defs/default" },
        "blank": {
          "description": "What an empty or whitespace-only value means: the default applies (unset), the value is refused (refused), or it is an empty list that replaces the default (clears_default).",
          "enum": ["unset", "refused", "clears_default"]
        },
        "sensitivity": {
          "enum": ["public", "host_path", "secret_locator", "may_carry_secret"]
        },
        "disclosure": {
          "description": "What a report, status view or diff may show: the value, or only whether the field is set.",
          "enum": ["value", "presence"]
        },
        "state_backends": {
          "description": "Which STATE_BACKEND the field is for: both, standalone only (cluster mode refuses it), or cluster only.",
          "enum": ["both", "standalone", "cluster"]
        },
        "reload": {
          "description": "When a new value takes effect: at the next start (restart), or at the next start and only through the environment (bootstrap).",
          "enum": ["restart", "bootstrap"]
        },
        "bundle": { "$ref": "#/$defs/bundle" },
        "platforms": { "$ref": "#/$defs/platforms" },
        "documentation": {
          "type": "string",
          "pattern": "^docs/configuration\\.md#[a-z][a-z0-9_]{0,127}$"
        }
      }
    },
    "decimal": {
      "description": "ADR-0008's decimal grammar.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,6})?$"
    },
    "decimalBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "inclusive"],
      "properties": {
        "value": { "$ref": "#/$defs/decimal" },
        "inclusive": { "type": "boolean" }
      }
    },
    "type": {
      "type": "object",
      "required": ["name"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "enum": ["boolean", "socket_address", "url", "path", "path_list", "text", "list", "json"]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["minimum", "maximum", "unit"],
          "properties": {
            "name": { "const": "integer" },
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 },
            "unit": {
              "enum": ["count", "bytes", "milliseconds", "seconds", "hours", "days"]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["decimal_minimum"],
          "properties": {
            "name": { "const": "decimal" },
            "decimal_minimum": { "$ref": "#/$defs/decimalBound" },
            "decimal_maximum": { "$ref": "#/$defs/decimalBound" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "name": { "const": "choice" },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "default": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": {
              "description": "The value that, set explicitly, compiles to exactly what leaving the field unset compiles to.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "unset" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "kind": { "const": "derived" },
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/variable" }
            }
          }
        }
      ]
    },
    "bundle": {
      "description": "What the field becomes in bundle and ledger modes (ADR-0008). No release can start from a bundle yet.",
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "kind": { "const": "deployment" },
            "path": {
              "description": "The field's JSON Pointer in a GatewayDeployment document, or null until the deployment schema defines it.",
              "type": ["string", "null"]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["category"],
          "properties": {
            "kind": { "const": "bootstrap" },
            "category": { "enum": ["host_locator", "secret_provider_wiring"] }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["resource", "not_representable", "unplaced"] }
          }
        }
      ]
    },
    "platforms": {
      "description": "Native, Compose and Kubernetes deployments set the gateway's environment directly. The Cloudflare wrapper forwards an exact allowlist and names a reason for every field it excludes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "compose", "kubernetes", "cloudflare"],
      "properties": {
        "native": { "const": "supported" },
        "compose": { "const": "supported" },
        "kubernetes": { "const": "supported" },
        "cloudflare": {
          "type": "object",
          "required": ["support"],
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "support": { "const": "forwarded" }
              }
            },
            {
              "additionalProperties": false,
              "required": ["reason"],
              "properties": {
                "support": { "const": "excluded" },
                "reason": {
                  "enum": [
                    "container_listener",
                    "single_container_port",
                    "edge_terminates_tls",
                    "no_grpc",
                    "no_client_certificates",
                    "cluster_mode",
                    "no_cluster_status"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}

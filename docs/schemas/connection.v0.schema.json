{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/connection.v0.schema.json",
  "title": "GreenGateway Connection Write Model",
  "description": "Version 0.1 write model for a logical upstream Connection. It contains opaque secret references only and never resolved secret material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "enabled",
    "kind",
    "endpoint",
    "authentication"
  ],
  "properties": {
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "enabled": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "http_api",
        "mcp_streamable_http"
      ]
    },
    "endpoint": {
      "$ref": "#/$defs/endpoint"
    },
    "caller_assertion": { "$ref": "#/$defs/caller_assertion" },
    "authentication": {
      "$ref": "#/$defs/authentication"
    },
    "additional_headers": {
      "type": "array",
      "maxItems": 4,
      "description": "Secret-backed headers injected alongside the primary credential, in this order, on every credentialed lane (tools, proxy, MCP, discovery, test). Each header name must be a non-reserved HTTP header name (never Authorization), must not name the primary credential's header, and must be unique within the list; names are normalized to lowercase. Adding, removing, or changing an entry is a secrets write.",
      "items": {
        "$ref": "#/$defs/additional_header"
      }
    },
    "tls": {
      "$ref": "#/$defs/tls"
    },
    "timeouts": {
      "$ref": "#/$defs/timeouts"
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "test_profile": {
      "$ref": "#/$defs/test_profile"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "authentication": {
            "allOf": [
              {
                "$ref": "#/$defs/authentication"
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "header_api_key"
                    }
                  }
                },
                "then": {
                  "required": [
                    "secret_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "static_bearer"
                    }
                  }
                },
                "then": {
                  "required": [
                    "secret_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "oauth2_client_credentials"
                    }
                  }
                },
                "then": {
                  "required": [
                    "client_secret_id"
                  ]
                }
              }
            ]
          },
          "additional_headers": {
            "items": {
              "required": [
                "secret_id"
              ]
            }
          },
          "tls": {
            "dependentRequired": {
              "client_certificate_id": [
                "client_private_key_id"
              ],
              "client_private_key_id": [
                "client_certificate_id"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "caller_assertion": {
      "type": "object",
      "additionalProperties": false,
      "description": "Attest the calling principal to the upstream alongside the primary credential rather than instead of it: the credential says which system is calling, the assertion says on whose behalf, so an upstream the operator controls can apply its own per-user checks. The gateway signs a short-lived JWT naming the validated principal and sends it in the named header; the upstream verifies it against the gateway's published JWKS. Omit to send only the credential.",
      "required": [
        "signing_key_id",
        "kid",
        "algorithm",
        "issuer",
        "audience",
        "token_type",
        "header_name",
        "lifetime_seconds"
      ],
      "properties": {
        "signing_key_id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Secret alias holding the PKCS#8 private key." },
        "kid": { "type": "string", "minLength": 1, "maxLength": 128, "description": "JOSE kid, published in the JWKS, so an upstream can select the right key and keys can rotate without a flag day." },
        "algorithm": { "enum": ["es256", "rs256"], "description": "Signature algorithm. Both are offered because verifier libraries and platform documentation differ on which is convenient." },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 512 },
        "token_type": { "type": "string", "minLength": 1, "maxLength": 128, "description": "JOSE typ. Naming the intended use stops a token minted for one upstream being replayed at another that trusts the same keys." },
        "header_name": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Header carrying the assertion. Must be a non-reserved HTTP header name and must differ from the header the primary credential uses; normalized to lowercase." },
        "lifetime_seconds": { "type": "integer", "minimum": 1, "maximum": 300, "description": "An assertion is a bearer credential for as long as it is valid, so this is a replay window rather than a convenience setting." },
        "claims": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["email", "roles"] }, "description": "Principal fields to attest beyond sub, which is always present. A closed set rather than free-form templating, so a configuration mistake cannot attest something a caller supplied." },
        "bind_request": { "type": "boolean", "description": "Include the method, path and a SHA-256 of the body actually sent, so an assertion cannot be lifted onto different arguments. The digest covers the transmitted bytes, not a canonical form, so an upstream verifies it with its standard library." },
        "bind_approval": { "type": "boolean", "description": "Require, and include, the approval that authorised a mutation." }
      }
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Opaque URL-safe identifier. Environment names, filesystem paths, and provider locators are not accepted by the admin connection model."
    },
    "origin_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^/(?!/)[^?#\\\\]*$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "base_path"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https?://"
        },
        "base_path": {
          "$ref": "#/$defs/origin_relative_path"
        }
      }
    },
    "authentication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "header_name"
          ],
          "properties": {
            "type": {
              "const": "header_api_key"
            },
            "header_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "secret_id": {
              "$ref": "#/$defs/stable_id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "static_bearer"
            },
            "secret_id": {
              "$ref": "#/$defs/stable_id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "client_id",
            "token_url",
            "client_auth_method"
          ],
          "properties": {
            "type": {
              "const": "oauth2_client_credentials"
            },
            "client_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "client_secret_id": {
              "$ref": "#/$defs/stable_id"
            },
            "token_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri",
              "pattern": "^https://"
            },
            "scopes": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^\\S+$"
              }
            },
            "audience": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "client_auth_method": {
              "const": "client_secret_basic"
            }
          }
        }
      ]
    },
    "additional_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_name"
      ],
      "properties": {
        "header_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "secret_id": {
          "$ref": "#/$defs/stable_id",
          "description": "Opaque ID of a header_api_key secret. Required once the Connection is enabled; a disabled draft may omit it."
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ca_bundle_alias": {
          "$ref": "#/$defs/stable_id"
        },
        "client_certificate_id": {
          "$ref": "#/$defs/stable_id"
        },
        "client_private_key_id": {
          "$ref": "#/$defs/stable_id"
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connect_timeout_ms",
        "request_timeout_ms",
        "response_idle_timeout_ms"
      ],
      "properties": {
        "connect_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "response_idle_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      }
    },
    "discovery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "use_connection_authentication"
          ],
          "properties": {
            "type": {
              "const": "managed_openapi"
            },
            "path": {
              "$ref": "#/$defs/origin_relative_path"
            },
            "use_connection_authentication": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "use_connection_authentication"
          ],
          "properties": {
            "type": {
              "const": "managed_mcp"
            },
            "use_connection_authentication": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "test_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "expected_statuses"
      ],
      "properties": {
        "method": {
          "description": "New writes allow only GET or HEAD. Previously persisted v0 OPTIONS profiles remain readable for upgrade compatibility, but are not accepted by this write schema or executed by the Connection test endpoint.",
          "enum": [
            "GET",
            "HEAD"
          ]
        },
        "path": {
          "$ref": "#/$defs/origin_relative_path"
        },
        "expected_statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        }
      }
    }
  }
}

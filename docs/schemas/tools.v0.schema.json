{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/tools.v0.schema.json",
  "title": "GreenGateway Tool Definitions",
  "description": "Draft 2020-12 JSON Schema for provider-agnostic MCP/API tool definitions. This file describes what tools are and how their calls map to upstream HTTP requests; runtime policy remains in the separate RBAC policy document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\."
    },
    "tools": {
      "type": "array",
      "description": "Tool definitions. Tool names must be unique; that cross-entry check is enforced by the Rust loader.",
      "items": {
        "$ref": "#/$defs/tool_definition"
      }
    }
  },
  "$defs": {
    "tool_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "input_json_schema",
        "upstream"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Stable tool name used by callers and policy. Names are unique within one tools file."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable tool description exposed to future MCP callers."
        },
        "input_json_schema": {
          "$ref": "#/$defs/json_schema_document",
          "description": "A complete JSON Schema document for this tool's argument object. The loader also compiles this schema to reject malformed schemas at load time."
        },
        "target": {
          "$ref": "#/$defs/tool_target",
          "description": "Optional typed connection target for connection-aware tools. The legacy upstream mapping remains required during migration."
        },
        "source": {
          "$ref": "#/$defs/tool_source",
          "description": "Optional typed provenance. Omission means legacy behavior."
        },
        "upstream": {
          "$ref": "#/$defs/upstream_mapping"
        },
        "visibility": {
          "enum": [
            "listed",
            "composite_only"
          ],
          "default": "listed",
          "description": "Where the tool is reachable from. composite_only tools are not advertised by tools/list and not callable through tools/call; they exist for composite steps and compensations and for the admin playground. Omission means listed."
        },
        "transform": {
          "$ref": "#/$defs/tool_transform",
          "description": "Optional compiled declarative request/response transform. Omission preserves the legacy request and response bytes exactly."
        }
      }
    },
    "stable_connection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "tool_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "connection_id",
            "mapping"
          ],
          "properties": {
            "type": {
              "const": "http"
            },
            "connection_id": {
              "$ref": "#/$defs/stable_connection_id"
            },
            "mapping": {
              "$ref": "#/$defs/typed_http_mapping"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "connection_id",
            "remote_tool_name"
          ],
          "properties": {
            "type": {
              "const": "mcp"
            },
            "connection_id": {
              "$ref": "#/$defs/stable_connection_id"
            },
            "remote_tool_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "tool_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "manual"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "connection_id"
          ],
          "properties": {
            "type": {
              "const": "open_api"
            },
            "connection_id": {
              "$ref": "#/$defs/stable_connection_id"
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "connection_id",
            "remote_tool_name"
          ],
          "properties": {
            "type": {
              "const": "mcp"
            },
            "connection_id": {
              "$ref": "#/$defs/stable_connection_id"
            },
            "remote_tool_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "legacy"
            }
          }
        }
      ]
    },
    "json_schema_document": {
      "description": "A JSON Schema document for a tool argument object. Tool schemas must declare an object-valued properties keyword so path-template placeholders can be checked against explicit arguments. Semantic schema validity is enforced by jsonschema::validator_for at registry load time.",
      "type": "object",
      "required": [
        "properties"
      ],
      "properties": {
        "properties": {
          "type": "object",
          "description": "Named tool-call arguments accepted by this tool."
        }
      }
    },
    "upstream_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path_template"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "HTTP method used for the future upstream request executor. The Rust loader rejects methods outside the known HTTP method set."
        },
        "path_template": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute upstream path template using {param}-style placeholders, such as /v1/widgets/{widget_id}."
        },
        "query_params": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/query_param_mapping"
          }
        },
        "body": {
          "$ref": "#/$defs/body_mapping"
        }
      }
    },
    "typed_http_mapping": {
      "allOf": [
        {
          "$ref": "#/$defs/upstream_mapping"
        },
        {
          "type": "object",
          "properties": {
            "path_template": {
              "type": "string",
              "pattern": "^/(?!/)[^?#\\\\]*$",
              "description": "Origin-relative path template. Semantic validation additionally rejects dot segments and encoded separators."
            }
          }
        }
      ]
    },
    "query_param_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arg_name",
        "query_name"
      ],
      "properties": {
        "arg_name": {
          "type": "string",
          "minLength": 1,
          "description": "Tool-call argument field to read."
        },
        "query_name": {
          "type": "string",
          "minLength": 1,
          "description": "Outbound query parameter name to write."
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether the future executor should require this argument before constructing the request."
        }
      }
    },
    "body_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "whole_args_json",
            "body_args_json"
          ],
          "description": "whole_args_json serializes the entire tool arguments object as the JSON body, path and query arguments included. body_args_json omits path-template placeholders and mapped query arguments from the body; the overlay compiler sets it on overlaid tools."
        }
      }
    },
    "local_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "agent_property_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~0|~1)*)*$",
      "maxLength": 512
    },
    "selector": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(/([A-Za-z0-9_.-]+(\\[[A-Za-z0-9_.-]+=(int:-?[0-9]{1,18}|bool:(true|false)|[^\\]/]{1,128})\\])?|\\*))+$"
    },
    "tool_transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/parameter_shape"
          }
        },
        "response_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/parameter_shape"
          }
        },
        "response_root": {
          "$ref": "#/$defs/selector"
        }
      },
      "anyOf": [
        {
          "required": [
            "parameters"
          ]
        },
        {
          "required": [
            "response_fields"
          ]
        },
        {
          "required": [
            "response_root"
          ]
        }
      ]
    },
    "parameter_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wire_property",
        "agent",
        "wire",
        "response"
      ],
      "properties": {
        "wire_property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "wire_required": {
          "type": "boolean",
          "default": false
        },
        "agent": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/agent_property"
          }
        },
        "wire": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/compiled_wire_binding"
          }
        },
        "response": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/compiled_response_binding"
          }
        }
      }
    },
    "agent_property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/agent_property_name"
        },
        "schema": {
          "type": "object"
        }
      }
    },
    "compiled_wire_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer"
      ],
      "properties": {
        "pointer": {
          "$ref": "#/$defs/json_pointer"
        },
        "from": {
          "$ref": "#/$defs/agent_property_name"
        },
        "const": {},
        "codec": {
          "$ref": "#/$defs/compiled_codec_chain"
        }
      },
      "oneOf": [
        {
          "required": [
            "from"
          ]
        },
        {
          "required": [
            "const"
          ]
        }
      ]
    },
    "compiled_response_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_property",
        "from"
      ],
      "properties": {
        "agent_property": {
          "$ref": "#/$defs/agent_property_name"
        },
        "from": {
          "$ref": "#/$defs/json_pointer"
        },
        "codec": {
          "$ref": "#/$defs/compiled_codec_chain"
        }
      }
    },
    "compiled_codec_chain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/compiled_codec"
      }
    },
    "compiled_codec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scale"
          ],
          "properties": {
            "kind": {
              "const": "decimal_scale"
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            },
            "wire_encoding": {
              "enum": [
                "integer_string",
                "integer"
              ],
              "default": "integer_string"
            },
            "max_integer_digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 38,
              "default": 24
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dialect"
          ],
          "properties": {
            "kind": {
              "const": "markdown_blocks"
            },
            "dialect": {
              "const": "blocknote"
            },
            "max_input_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144,
              "default": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "json_string"
            }
          }
        }
      ]
    }
  }
}

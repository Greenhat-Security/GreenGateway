    "/v1/admin/tools": {
      "get": {
        "operationId": "listCapabilities",
        "tags": [
          "Capabilities"
        ],
        "summary": "List unified safe capabilities",
        "description": "Requires admin:tools:read. The page combines manual, managed OpenAPI/MCP, and projected legacy capabilities.",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "enum": [
                "tool",
                "resource",
                "resource_template"
              ]
            }
          },
          {
            "name": "connection_id",
            "in": "query",
            "schema": {
              "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/StableId"
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "enum": [
                "manual_file",
                "openapi",
                "mcp_discovery",
                "projected_legacy_config"
              ]
            }
          },
          {
            "name": "available",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "availability",
            "in": "query",
            "schema": {
              "enum": [
                "available",
                "unavailable",
                "stale"
              ]
            }
          },
          {
            "name": "text",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "$ref": "#/components/parameters/CapabilityLimit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Safe capability page.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/CapabilityList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        }
      }
    },
    "/v1/admin/tools/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpaqueCapabilityId"
          }
        }
      ],
      "get": {
        "operationId": "getCapability",
        "tags": [
          "Capabilities"
        ],
        "summary": "Get safe capability detail and execution precondition",
        "description": "Requires admin:tools:read. The ETag binds the caller-visible definition, policy eligibility, and Connection/catalog revision.",
        "responses": {
          "200": {
            "description": "Safe capability detail.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/CapabilityDetail"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        }
      }
    },
    "/v1/admin/tools/{id}/execute": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpaqueCapabilityId"
          }
        }
      ],
      "post": {
        "operationId": "executeCapabilityInPlayground",
        "tags": [
          "Capabilities"
        ],
        "summary": "Execute a constrained registered tool",
        "description": "Requires admin:tools:execute and the exact strong capability ETag. The body can contain arguments only; URL/header/credential/TLS/timeout/Connection overrides are not accepted. HTTP response headers and non-success bodies are withheld.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/PlaygroundRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded projected HTTP or MCP result.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/PlaygroundResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A validated bearer JWT or ggw_ service token. A bearer-authenticated mutation is exempt from the cookie double-submit CSRF check."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "The default session cookie. AUTH_COOKIE_NAME changes this name. When CSRF_ENABLED is true (the default), every cookie-authenticated POST, PUT, or DELETE also requires the double-submit CSRF_COOKIE_NAME cookie and matching CSRF_HEADER_NAME header. The default CSRF names are csrf_token and x-csrf-token."
      },
      "csrfCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csrf_token",
        "description": "The default double-submit CSRF cookie for cookie-authenticated mutations. CSRF_COOKIE_NAME changes this name; CSRF_ENABLED defaults to true."
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "The default double-submit CSRF header. CSRF_HEADER_NAME changes this name, and its value must exactly match the configured CSRF cookie."
      }
    },
    "parameters": {
      "StableId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/StableId"
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "Exactly one current strong entity tag. Missing preconditions return 428 and stale preconditions return 412.",
        "schema": {
          "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/Etag"
        }
      },
      "OpenApiOverlayIfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "Exactly one current strong overlay ETag. Missing preconditions return 428 and stale Connection, catalog, or overlay revisions return 412.",
        "schema": {
          "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayEtag"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "ConnectionLimit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "CapabilityLimit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "Strong ETag for the returned representation or resource.",
        "schema": {
          "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/Etag"
        }
      },
      "OpenApiOverlayETag": {
        "description": "Strong overlay ETag in the form \"overlay:{connection_id}:c{connection_revision}:r{catalog_revision}:o{overlay_revision}\"; o0 means no overlay is stored. The Connection and catalog revisions prevent ABA reuse after overlay recreation or a kind replacement that rebuilds the OpenAPI catalog.",
        "schema": {
          "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayEtag"
        }
      },
      "ConnectionCollectionETag": {
        "description": "Canonical current Connection collection ETag used by create and stale-cursor preconditions.",
        "schema": {
          "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/Etag"
        }
      },
      "SecretCollectionETag": {
        "description": "Canonical current connection-secret collection ETag used by create preconditions.",
        "schema": {
          "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/Etag"
        }
      },
      "NoStore": {
        "description": "Sensitive control-plane representations are not cacheable.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      }
    },
    "schemas": {
      "AdminError": {
        "oneOf": [
          {
            "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/Error"
          },
          {
            "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ReasonedError"
          },
          {
            "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ValidationError"
          },
          {
            "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayValidationError"
          },
          {
            "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/DependencyConflict"
          }
        ]
      }
    },
    "responses": {
      "AdminError": {
        "description": "Stable sanitized error body. Authorization and availability details remain bounded.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminError"
            }
          }
        }
      },
      "OpenApiOverlayValidationError": {
        "description": "The candidate overlay was rejected. The prior overlay, catalog, source reports, and registry lane are unchanged.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayValidationError"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/policy-tests.v1.schema.json",
  "title": "GreenGateway policy test suite",
  "description": "Draft 2020-12 JSON Schema for a policy-tests.v1 suite of synthetic policy test cases. The gateway's parser is authoritative and also enforces what JSON Schema cannot state here: path, host and origin syntax, principal shape bounds, unique case ids, that a rate sequence's virtual instants never decrease and that expected steps list one outcome per sequence step, that a hypothetical address is an IP socket address, and byte (not character) limits. Unknown members are refused everywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": "policy-tests.v1" },
    "description": { "$ref": "#/$defs/description" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "case_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "method": { "type": "string", "minLength": 1, "maxLength": 64 },
    "path": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^/" },
    "host": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "dispatch_fact": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "tool_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "position": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "rate_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ms"],
      "properties": {
        "at_ms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "integer", "minimum": 0, "maximum": 86400000 }
        }
      }
    },
    "egress_destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9+.-]*$" },
        "host": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "userinfo": { "type": "boolean" },
        "fragment": { "type": "boolean" }
      }
    },
    "egress_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothetical_addresses"],
      "properties": {
        "hypothetical_addresses": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "principal": {
      "oneOf": [
        { "const": "anonymous" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "auth_method"],
          "properties": {
            "subject": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "issuer": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "roles": {
              "type": "array",
              "maxItems": 256,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "auth_method": {
              "enum": ["bearer_token", "session_cookie", "service_token", "client_certificate"]
            },
            "organization": {
              "description": "The organization authentication verified for the principal, which an identity mapping or an organization condition may test. Omitted, the principal has none, exactly as a principal whose provider verified none. It is read only when a mapping or condition reads it, as on the live lanes.",
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "contextless" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "canonical_path"],
          "properties": {
            "kind": { "const": "mcp_alias" },
            "canonical_path": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "upstream_origin"],
          "properties": {
            "kind": { "const": "proxy_dispatch" },
            "upstream_origin": { "$ref": "#/$defs/dispatch_fact" },
            "route_id": { "$ref": "#/$defs/dispatch_fact" },
            "route_host": { "$ref": "#/$defs/host" },
            "route_path_prefix": { "$ref": "#/$defs/dispatch_fact" }
          }
        }
      ]
    },
    "http_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "host": { "$ref": "#/$defs/host" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "method_and_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "logical": { "enum": ["allow", "deny"] },
    "effect": { "enum": ["allow", "block", "observe"] },
    "matched_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": { "rule": { "$ref": "#/$defs/dispatch_fact" } }
    },
    "http_expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical"],
      "properties": {
        "logical": { "$ref": "#/$defs/logical" },
        "effect": { "$ref": "#/$defs/effect" },
        "reason": {
          "enum": [
            "matched_rule",
            "missing_permission",
            "missing_principal",
            "default_allow",
            "default_deny",
            "host_policy_required"
          ]
        },
        "matched": {
          "oneOf": [
            { "const": "none" },
            { "$ref": "#/$defs/matched_rule" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["route"],
              "properties": { "route": { "$ref": "#/$defs/position" } }
            }
          ]
        }
      }
    },
    "tool_expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical"],
      "properties": {
        "logical": { "$ref": "#/$defs/logical" },
        "effect": { "$ref": "#/$defs/effect" },
        "reason": {
          "enum": [
            "unknown_tool",
            "disabled",
            "role_not_allowed",
            "matched_rule",
            "allowed",
            "not_in_policy",
            "policy_disabled",
            "principal_not_eligible",
            "policy_denied",
            "eligible",
            "no_http_rule"
          ]
        },
        "matched": {
          "oneOf": [{ "const": "none" }, { "$ref": "#/$defs/matched_rule" }]
        }
      }
    },
    "fact_values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 8192 }
    },
    "request_facts": {
      "description": "The request facts an http case states for the rule conditions a policy may carry. A member omitted is a fact the case does not state: a condition that reads it is indeterminate, never a guessed match. An empty headers or query object states a request that carried none. Header names are lowercase; a header or query name that can carry a credential, an identity or hop-by-hop routing is refused (forbidden_field). At most 128 occurrences each.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip": { "$ref": "#/$defs/source_ip" },
        "headers": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]{1,256}$" },
          "additionalProperties": { "$ref": "#/$defs/fact_values" }
        },
        "query": {
          "type": "object",
          "propertyNames": { "minLength": 1, "maxLength": 256 },
          "additionalProperties": { "$ref": "#/$defs/fact_values" }
        },
        "now": { "$ref": "#/$defs/instant" }
      }
    },
    "invocation_facts": {
      "description": "The facts a tool case states: a source address, an instant and, for the invocation operation only, the call's arguments (fact_not_applicable for a visibility or eligibility preview, which never has a call's arguments). No headers or query: a tool call has none of its own.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip": { "$ref": "#/$defs/source_ip" },
        "now": { "$ref": "#/$defs/instant" },
        "arguments": { "$ref": "#/$defs/tool_arguments" }
      }
    },
    "tool_arguments": {
      "description": "A tool invocation's arguments as they stand once the tool's input schema has accepted them: one JSON object nested at most 8 levels deep, of at most 128 values (too_many_facts) with member names of at most 256 bytes and strings of at most 8192 bytes. Only the scalars at the pointers the tool's tool_argument conditions read are evaluated, as on the live lane; no value is ever repeated. The tool's schema is not consulted, so pointer eligibility is not judged here.",
      "type": "object",
      "propertyNames": { "maxLength": 256 }
    },
    "call_facts": {
      "description": "The facts a tool_http case states: a rendered tool request has a source address and an instant, but no headers or query of its own (fact_not_applicable).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip": { "$ref": "#/$defs/source_ip" },
        "now": { "$ref": "#/$defs/instant" }
      }
    },
    "source_ip": {
      "description": "The canonical client address the gateway derives after trusted-proxy processing: an IPv4 or IPv6 address without a port.",
      "type": "string",
      "minLength": 2,
      "maxLength": 45
    },
    "instant": {
      "description": "The evaluation instant, an RFC 3339 UTC instant written YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "egress_expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical"],
      "properties": {
        "logical": { "$ref": "#/$defs/logical" },
        "reason": {
          "enum": [
            "allowed",
            "missing_host",
            "userinfo",
            "fragment",
            "scheme_not_allowed",
            "host_not_allowed",
            "missing_port",
            "port_not_allowed",
            "empty_resolution",
            "unexpected_resolved_port",
            "non_global_address"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "kind", "expect"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["principal", "request"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "http" },
            "principal": { "$ref": "#/$defs/principal" },
            "request": { "$ref": "#/$defs/http_request" },
            "facts": { "$ref": "#/$defs/request_facts" },
            "expect": { "$ref": "#/$defs/http_expect" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["principal", "tool"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "tool" },
            "principal": { "$ref": "#/$defs/principal" },
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "$ref": "#/$defs/tool_name" },
                "operation": { "enum": ["invocation", "visibility", "eligibility"] }
              }
            },
            "facts": { "$ref": "#/$defs/invocation_facts" },
            "expect": { "$ref": "#/$defs/tool_expect" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["principal", "tool", "request"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "tool_http" },
            "principal": { "$ref": "#/$defs/principal" },
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "$ref": "#/$defs/tool_name" } }
            },
            "request": { "$ref": "#/$defs/method_and_path" },
            "facts": { "$ref": "#/$defs/call_facts" },
            "expect": { "$ref": "#/$defs/tool_expect" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["principal", "request"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "rate" },
            "principal": { "$ref": "#/$defs/principal" },
            "request": { "$ref": "#/$defs/method_and_path" },
            "sequence": { "$ref": "#/$defs/rate_sequence" },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rate_override"],
              "properties": {
                "rate_override": {
                  "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/position" }]
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": { "enum": ["allowed", "limited"] }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["destination"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "egress" },
            "destination": { "$ref": "#/$defs/egress_destination" },
            "resolution": { "$ref": "#/$defs/egress_resolution" },
            "expect": { "$ref": "#/$defs/egress_expect" }
          }
        }
      ]
    }
  }
}

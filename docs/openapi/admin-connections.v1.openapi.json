  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A validated bearer JWT or ggw_ service token. A bearer-authenticated mutation is exempt from the cookie double-submit CSRF check."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "The default session cookie. AUTH_COOKIE_NAME changes this name. When CSRF_ENABLED is true (the default), every cookie-authenticated POST, PUT, or DELETE also requires the double-submit CSRF_COOKIE_NAME cookie and matching CSRF_HEADER_NAME header. The default CSRF names are csrf_token and x-csrf-token."
      },
      "csrfCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csrf_token",
        "description": "The default double-submit CSRF cookie for cookie-authenticated mutations. CSRF_COOKIE_NAME changes this name; CSRF_ENABLED defaults to true."
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "The default double-submit CSRF header. CSRF_HEADER_NAME changes this name, and its value must exactly match the configured CSRF cookie."
      }
    },

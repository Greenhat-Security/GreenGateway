      "parameters": [
        {
          "$ref": "#/components/parameters/StableId"
        }
      ],
      "put": {
        "operationId": "rotateEncryptedConnectionSecret",
        "tags": [
          "Connection secrets"
        ],
        "summary": "Rotate an encrypted-local value",
        "description": "Requires admin:connections:secrets:write and the exact item ETag. Operator-provisioned aliases are read-only.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/SecretRotateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Safe rotated alias metadata.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "x-greengateway-connection-secrets-etag": {
                "$ref": "#/components/headers/SecretCollectionETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/SafeSecretAlias"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      },
      "delete": {
        "operationId": "deleteEncryptedConnectionSecret",
        "tags": [
          "Connection secrets"
        ],
        "summary": "Delete an unreferenced encrypted-local alias",
        "description": "Requires admin:connections:secrets:write and the exact item ETag. Referenced and operator-provisioned aliases cannot be deleted.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted alias identifier.",
            "headers": {
              "x-greengateway-connection-secrets-etag": {
                "$ref": "#/components/headers/SecretCollectionETag"
              },

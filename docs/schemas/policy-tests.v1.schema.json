{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/policy-tests.v1.schema.json",
  "title": "GreenGateway policy test suite",
  "description": "Draft 2020-12 JSON Schema for a policy-tests.v1 suite of synthetic policy test cases. The gateway's parser is authoritative and also enforces what JSON Schema cannot state here: path, host and origin syntax, principal shape bounds, unique case ids, and byte (not character) limits. Unknown members are refused everywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": "policy-tests.v1" },
    "description": { "$ref": "#/$defs/description" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "case_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "method": { "type": "string", "minLength": 1, "maxLength": 64 },
    "path": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^/" },
    "host": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "dispatch_fact": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "tool_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "position": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "principal": {
      "oneOf": [
        { "const": "anonymous" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "auth_method"],
          "properties": {
            "subject": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "issuer": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "roles": {
              "type": "array",
              "maxItems": 256,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "auth_method": {
              "enum": ["bearer_token", "session_cookie", "service_token", "client_certificate"]
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "contextless" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "canonical_path"],
          "properties": {
            "kind": { "const": "mcp_alias" },
            "canonical_path": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "upstream_origin"],
          "properties": {
            "kind": { "const": "proxy_dispatch" },
            "upstream_origin": { "$ref": "#/$defs/dispatch_fact" },
            "route_id": { "$ref": "#/$defs/dispatch_fact" },
            "route_host": { "$ref": "#/$defs/host" },
            "route_path_prefix": { "$ref": "#/$defs/dispatch_fact" }
          }
        }
      ]
    },
    "http_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "host": { "$ref": "#/$defs/host" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "method_and_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "logical": { "enum": ["allow", "deny"] },
    "effect": { "enum": ["allow", "block", "observe"] },
    "matched_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": { "rule": { "$ref": "#/$defs/dispatch_fact" } }
    },
    "http_expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical"],
      "properties": {
        "logical": { "$ref": "#/$defs/logical" },
        "effect": { "$ref": "#/$defs/effect" },
        "reason": {
          "enum": [
            "matched_rule",
            "missing_permission",
            "missing_principal",
            "default_allow",
            "default_deny",
            "host_policy_required"
          ]
        },
        "matched": {
          "oneOf": [
            { "const": "none" },
            { "$ref": "#/$defs/matched_rule" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["route"],
              "properties": { "route": { "$ref": "#/$defs/position" } }
            }
          ]
        }
      }
    },
    "tool_expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical"],
      "properties": {
        "logical": { "$ref": "#/$defs/logical" },
        "effect": { "$ref": "#/$defs/effect" },
        "reason": {
          "enum": [
            "unknown_tool",
            "disabled",
            "role_not_allowed",
            "matched_rule",
            "allowed",
            "not_in_policy",
            "policy_disabled",
            "principal_not_eligible",
            "policy_denied",
            "eligible",
            "no_http_rule"
          ]
        },
        "matched": {
          "oneOf": [{ "const": "none" }, { "$ref": "#/$defs/matched_rule" }]
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "kind", "principal", "expect"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["request"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "http" },
            "principal": { "$ref": "#/$defs/principal" },
            "request": { "$ref": "#/$defs/http_request" },
            "expect": { "$ref": "#/$defs/http_expect" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "tool" },
            "principal": { "$ref": "#/$defs/principal" },
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "$ref": "#/$defs/tool_name" },
                "operation": { "enum": ["invocation", "visibility", "eligibility"] }
              }
            },
            "expect": { "$ref": "#/$defs/tool_expect" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["tool", "request"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "tool_http" },
            "principal": { "$ref": "#/$defs/principal" },
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "$ref": "#/$defs/tool_name" } }
            },
            "request": { "$ref": "#/$defs/method_and_path" },
            "expect": { "$ref": "#/$defs/tool_expect" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["request"],
          "properties": {
            "id": { "$ref": "#/$defs/case_id" },
            "description": { "$ref": "#/$defs/description" },
            "kind": { "const": "rate" },
            "principal": { "$ref": "#/$defs/principal" },
            "request": { "$ref": "#/$defs/method_and_path" },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rate_override"],
              "properties": {
                "rate_override": {
                  "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/position" }]
                }
              }
            }
          }
        }
      ]
    }
  }
}

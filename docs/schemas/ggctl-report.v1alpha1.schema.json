{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/ggctl-report.v1alpha1.schema.json",
  "title": "ggctl Report",
  "description": "The one document ggctl writes to standard output with --format json, for every command that does not write an artifact. exitCode and outcome are the process exit status and its stable name. Diagnostics are value-free: a stable family.reason code, fixed message text, an optional fixed hint, a documentation anchor, and at most the 1-based position of the command-line argument concerned; never an argument, token, URL, path, server response, or library error. A published diagnostic code never changes meaning; renaming or removing one requires a new report version. An argument error found before a command runs writes no report (exit 2, standard error only).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "command", "exitCode", "outcome", "diagnostics", "result"],
  "properties": {
    "apiVersion": {
      "description": "Exact document version. No other version, prefix, or spelling is accepted.",
      "const": "greengateway.dev/v1alpha1"
    },
    "kind": {
      "const": "GgctlReport"
    },
    "command": {
      "enum": ["version", "schema"]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "outcome": {
      "enum": ["success", "failure", "usage", "invalid", "drift", "conflict", "unavailable", "integrity", "denied"]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "result": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"command": {"const": "version"}}
      },
      "then": {
        "properties": {"result": {"$ref": "#/$defs/versionResult"}}
      }
    },
    {
      "if": {
        "properties": {"command": {"const": "schema"}}
      },
      "then": {
        "properties": {"result": {"$ref": "#/$defs/schemaResult"}}
      }
    }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "remediation"],
      "properties": {
        "code": {
          "description": "The stable family.reason code. docs/ggctl.md lists every code by family.",
          "type": "string",
          "pattern": "^(usage|credential|trust|remote|compat|schema|output|internal)\\.[a-z][a-z0-9_]*$"
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "message": {
          "description": "Fixed text chosen by the code.",
          "type": "string"
        },
        "hint": {
          "description": "Fixed guidance chosen by ggctl, never derived from input.",
          "type": "string"
        },
        "remediation": {
          "description": "A repository documentation anchor.",
          "type": "string",
          "pattern": "^docs/ggctl\\.md#[a-z]+-diagnostics$"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argument"],
          "properties": {
            "argument": {
              "description": "The 1-based position of the command-line argument after ggctl.",
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "documentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind"],
      "properties": {
        "apiVersion": {"type": "string"},
        "kind": {"type": "string"}
      }
    },
    "versionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "schemas"],
      "properties": {
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "ggctl"},
            "version": {"type": "string"}
          }
        },
        "schemas": {
          "description": "The document versions this ggctl publishes schemas for.",
          "type": "array",
          "items": {"$ref": "#/$defs/documentVersion"}
        },
        "server": {
          "description": "Present only with --server. compatible is true only when the server's capability document was read and is one this ggctl implements; gatewayVersion appears when the server stated a well-formed one, and capabilities only when compatible.",
          "type": "object",
          "additionalProperties": false,
          "required": ["compatible"],
          "properties": {
            "compatible": {"type": "boolean"},
            "gatewayVersion": {"type": "string"},
            "capabilities": {
              "description": "The server's GatewayCapabilities document as ggctl read it; gateway-capabilities.v1alpha1.schema.json is its schema.",
              "type": "object"
            }
          }
        }
      }
    },
    "schemaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemas"],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {"$ref": "#/$defs/documentVersion"}
        }
      }
    },
    "diffResult": {
      "description": "A semantic diff between two compiled configurations, as gateway-config computes it (docs/semantic-diff.md). No command writes it yet: `ggctl diff` reports it once the bundle reader and compiler move into gateway-config (#242 PR 8). Value-free by construction: only booleans, fixed words and numbers are ever shown; every other value is withheld, and a secret, secret reference or locator is reported only as a changed reference.",
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "severity", "riskCodes", "sections", "changes"],
      "properties": {
        "changed": {
          "description": "true when any field differs.",
          "type": "boolean"
        },
        "severity": {
          "description": "The highest severity of any risk code, none when no change carries one.",
          "$ref": "#/$defs/riskSeverity"
        },
        "riskCodes": {
          "description": "Every change's risk codes, sorted and without duplicates.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/riskCode"}
        },
        "sections": {
          "description": "The sections with a change.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/configSection"}
        },
        "changes": {
          "description": "One entry per field that differs, ordered by section and field.",
          "type": "array",
          "items": {"$ref": "#/$defs/configChange"}
        }
      }
    },
    "riskSeverity": {
      "enum": ["none", "low", "medium", "high"]
    },
    "riskCode": {
      "description": "A stable risk code. A published code never changes meaning; renaming or removing one requires a new report version.",
      "enum": [
        "risk.admin_access_path_removed",
        "risk.audit_durability_reduced",
        "risk.auth_disabled",
        "risk.auth_observe_only",
        "risk.auth_trust_changed",
        "risk.cookie_or_csrf_weakened",
        "risk.cors_broadened",
        "risk.credential_binding_changed",
        "risk.data_exposure_increased",
        "risk.egress_broadened",
        "risk.exemptions_broadened",
        "risk.limits_loosened",
        "risk.listener_exposed",
        "risk.plaintext_transport",
        "risk.policy_broadened",
        "risk.policy_default_allow",
        "risk.private_egress_allowed",
        "risk.profile_changed",
        "risk.public_origin_changed",
        "risk.routing_changed",
        "risk.shadow_enabled",
        "risk.storage_changed",
        "risk.tls_weakened",
        "risk.tool_surface_broadened",
        "risk.trusted_proxies_changed",
        "risk.unknown_impact"
      ]
    },
    "configSection": {
      "enum": [
        "bundle",
        "listeners",
        "tls",
        "authentication",
        "admin",
        "browser_security",
        "proxy_trust",
        "routing",
        "egress",
        "limits",
        "audit",
        "observability",
        "storage",
        "cluster",
        "connections",
        "lifecycle",
        "policy",
        "tools"
      ]
    },
    "configChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "section", "kind", "class", "effect", "severity", "riskCodes", "value"],
      "properties": {
        "field": {
          "description": "The stable field identifier: an environment setting name for a deployment setting, or a dotted document path for a bundle or resource member.",
          "type": "string",
          "pattern": "^(?:[A-Z][A-Z0-9_]*|[a-z][a-z0-9_]*(?:[.][a-z][a-z0-9_]*)+)$"
        },
        "section": {"$ref": "#/$defs/configSection"},
        "kind": {
          "enum": ["added", "removed", "modified"]
        },
        "class": {
          "description": "How the change can take effect (ADR-0008, Change classes).",
          "enum": ["live", "restart", "coordinated_cutover", "bootstrap", "connection_or_secret", "cluster_operation", "unsupported"]
        },
        "effect": {
          "description": "loosened when any facet weakens a control, otherwise unknown when no detector can tell, otherwise tightened or neutral.",
          "enum": ["loosened", "unknown", "tightened", "neutral"]
        },
        "severity": {"$ref": "#/$defs/riskSeverity"},
        "riskCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/riskCode"}
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["display", "before", "after"],
              "properties": {
                "display": {"const": "shown"},
                "before": {"$ref": "#/$defs/shownValue"},
                "after": {"$ref": "#/$defs/shownValue"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["display"],
              "properties": {
                "display": {"enum": ["withheld", "reference"]}
              }
            }
          ]
        },
        "entries": {
          "description": "For a collection: how many entries were added, removed and changed. Entry names are never reported.",
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed", "changed"],
          "properties": {
            "added": {"type": "integer", "minimum": 0},
            "removed": {"type": "integer", "minimum": 0},
            "changed": {"type": "integer", "minimum": 0}
          }
        }
      },
      "if": {
        "properties": {"effect": {"enum": ["tightened", "neutral"]}}
      },
      "then": {
        "properties": {
          "riskCodes": {"maxItems": 0},
          "severity": {"const": "none"}
        }
      },
      "else": {
        "properties": {
          "riskCodes": {"minItems": 1},
          "severity": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "shownValue": {
      "description": "A boolean, a fixed word, a number, or the word unbounded.",
      "type": ["boolean", "string", "number"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greengateway.dev/schemas/policy-evidence.v1.schema.json",
  "title": "GreenGateway policy evidence package",
  "description": "Draft 2020-12 JSON Schema for a policy-evidence.v1 package: an envelope whose manifest names, in order, the policy-evidence-report.v1 report, the policy-analysis-results.v1 analysis when the request asked for one, and the Markdown rendering of the report, each by its ADR-0004 digest (semantic for the JSON artifacts, source for the Markdown) and its size in bytes. Each manifest entry names the envelope member of the same name. A package is served as its RFC 8785 bytes. The test, simulation, replay and analysis results inside a package follow the result formats of their own endpoints (policy-test-results.v1, policy-simulation results, policy-replay-results.v1 and policy-analysis-results.v1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "manifest", "report", "report_markdown"],
  "if": { "required": ["analysis"] },
  "then": {
    "properties": {
      "manifest": {
        "prefixItems": [
          { "$ref": "#/$defs/report_entry" },
          { "$ref": "#/$defs/analysis_entry" },
          { "$ref": "#/$defs/markdown_entry" }
        ],
        "minItems": 3,
        "items": false
      }
    }
  },
  "else": {
    "properties": {
      "manifest": {
        "prefixItems": [{ "$ref": "#/$defs/report_entry" }, { "$ref": "#/$defs/markdown_entry" }],
        "minItems": 2,
        "items": false
      }
    }
  },
  "properties": {
    "schema_version": { "const": "policy-evidence.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "manifest": {
      "description": "The report, then the analysis when the package carries one, then the Markdown.",
      "type": "array"
    },
    "report": { "$ref": "#/$defs/report" },
    "analysis": {
      "description": "The structural analyzer's policy-analysis-results.v1 document for the candidate, exactly as POST /policy/analyses renders the same candidate's analysis, except that it names no base: no active policy was pinned.",
      "type": "object",
      "required": ["schema_version", "mode", "analyzed", "complete", "limitations", "suppressions", "summary", "findings"],
      "properties": {
        "schema_version": { "const": "policy-analysis-results.v1" },
        "mode": { "const": "structural" },
        "complete": { "type": "boolean" },
        "findings": { "type": "array" }
      }
    },
    "report_markdown": {
      "description": "The report rendered through a fixed template from its RFC 8785 bytes alone: GitHub-flavored Markdown that repeats only values the report holds, each as an inline code span, and the report's trust statement verbatim.",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "etag": { "type": "string", "pattern": "^\"sha256:[0-9a-f]{64}\"$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "report_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "schema_version", "digest", "size"],
      "properties": {
        "name": { "const": "report" },
        "media_type": { "const": "application/vnd.greengateway.policy-evidence-report+json" },
        "schema_version": { "const": "policy-evidence-report.v1" },
        "digest": { "$ref": "#/$defs/digest" },
        "size": { "$ref": "#/$defs/size" }
      }
    },
    "analysis_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "schema_version", "digest", "size"],
      "properties": {
        "name": { "const": "analysis" },
        "media_type": { "const": "application/vnd.greengateway.policy-analysis-results+json" },
        "schema_version": { "const": "policy-analysis-results.v1" },
        "digest": { "$ref": "#/$defs/digest" },
        "size": { "$ref": "#/$defs/size" }
      }
    },
    "markdown_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "schema_version", "digest", "size"],
      "properties": {
        "name": { "const": "report_markdown" },
        "media_type": { "const": "text/markdown; charset=utf-8; variant=GFM" },
        "schema_version": { "const": "policy-evidence-report-markdown.v1" },
        "digest": { "$ref": "#/$defs/digest" },
        "size": { "$ref": "#/$defs/size" }
      }
    },
    "policy_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "etag", "semantic_digest"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "etag": { "$ref": "#/$defs/etag" },
        "semantic_digest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    },
    "not_included": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included"],
      "properties": { "included": { "const": false } }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "policy", "predecessor", "predecessor_check"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "policy": { "$ref": "#/$defs/policy_identity" },
        "predecessor": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "policy"],
              "properties": {
                "version": { "$ref": "#/$defs/version" },
                "policy": { "$ref": "#/$defs/policy_identity" }
              }
            }
          ]
        },
        "predecessor_check": {
          "enum": [
            "matches_recorded_base",
            "differs_from_recorded_base",
            "no_recorded_base",
            "no_predecessor"
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "recorded_at", "actor", "operation"],
      "properties": {
        "basis": { "const": "authorized_commit" },
        "recorded_at": { "type": "string" },
        "actor": { "const": "withheld" },
        "operation": {
          "enum": [
            "imported_from_standalone",
            "policy_draft_published",
            "policy_replaced",
            "policy_rolled_back",
            "rule_created",
            "rule_deleted",
            "rule_updated",
            "rules_reordered",
            "unrecognized",
            "not_recorded"
          ]
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "base_etag"],
          "properties": {
            "revision": { "type": "integer", "minimum": 0 },
            "base_etag": { "$ref": "#/$defs/etag" }
          }
        },
        "shadow_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transition", "policy_etag", "evidence_digest"],
          "properties": {
            "transition": { "enum": ["promote", "disable"] },
            "policy_etag": { "$ref": "#/$defs/etag" },
            "evidence_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "rollback_target_version": { "type": "integer", "minimum": 0 },
        "rule_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "draft": {
      "description": "The server-side draft a draft's package is about, read as its owner at the pinned draft ETag, and the live policy it is pinned to.",
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "revision", "draft_etag", "policy", "base"],
      "properties": {
        "draft_id": { "type": "string", "pattern": "^pd_[0-9a-f]{32}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "draft_etag": { "$ref": "#/$defs/etag" },
        "policy": { "$ref": "#/$defs/policy_identity" },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "policy"],
          "properties": {
            "source": { "const": "active" },
            "policy": { "$ref": "#/$defs/policy_identity" }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "fingerprint", "severity", "proof_basis", "element", "suppression"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "severity": { "enum": ["high", "medium", "low"] },
        "proof_basis": { "enum": ["proven", "bounded_replay", "heuristic", "inconclusive"] },
        "element": {
          "type": "object",
          "required": ["section", "pointer"],
          "properties": {
            "section": { "type": "string" },
            "pointer": { "type": "string" },
            "position": { "type": "integer", "minimum": 0 },
            "id": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "suppression": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "suppression_id"],
              "properties": {
                "state": { "enum": ["suppressed", "suppression_expired", "suppression_mismatched"] },
                "suppression_id": { "type": "string", "minLength": 1 },
                "mismatched": {
                  "type": "array",
                  "items": { "enum": ["policy", "resource_snapshot"] }
                }
              }
            }
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "redaction_profile",
        "candidate_kind",
        "gateway_version",
        "evaluator",
        "request_digest",
        "validation",
        "tests",
        "simulation",
        "replay",
        "analysis",
        "completeness",
        "limitations",
        "trust"
      ],
      "if": { "properties": { "candidate_kind": { "const": "draft" } } },
      "then": {
        "required": ["draft"],
        "not": { "anyOf": [{ "required": ["publication"] }, { "required": ["approval"] }] },
        "properties": {
          "trust": { "properties": { "statement": { "pattern": "^This package is unsigned\\. It reports one server-side policy draft," } } }
        }
      },
      "else": {
        "required": ["publication", "approval"],
        "not": { "required": ["draft"] },
        "properties": {
          "trust": { "properties": { "statement": { "pattern": "^This package is unsigned\\. It reports what this gateway's policy history recorded about one publication" } } }
        }
      },
      "properties": {
        "schema_version": { "const": "policy-evidence-report.v1" },
        "redaction_profile": { "const": "policy-evidence-aggregate.v1" },
        "candidate_kind": { "enum": ["publication", "draft"] },
        "gateway_version": { "type": "string", "minLength": 1 },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "http_semantics_version",
            "http_context_version",
            "tool_semantics_version",
            "tool_context_version",
            "replay_context_version"
          ],
          "properties": {
            "http_semantics_version": { "type": "string" },
            "http_context_version": { "type": "integer" },
            "tool_semantics_version": { "type": "string" },
            "tool_context_version": { "type": "integer" },
            "replay_context_version": { "type": "string" }
          }
        },
        "request_digest": { "$ref": "#/$defs/digest" },
        "publication": { "$ref": "#/$defs/publication" },
        "approval": { "$ref": "#/$defs/approval" },
        "draft": { "$ref": "#/$defs/draft" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "valid", "diagnostics", "diagnostics_truncated", "resource_snapshot"],
          "properties": {
            "basis": { "const": "revalidated_by_this_build" },
            "valid": { "type": "boolean" },
            "diagnostics": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["code", "severity", "pointer", "message", "remediation", "blocks"],
                "properties": {
                  "code": { "type": "string" },
                  "severity": { "enum": ["error", "warning", "risk"] },
                  "pointer": { "type": "string" },
                  "element_id": { "type": "string" },
                  "message": { "type": "string" },
                  "remediation": { "type": "string" },
                  "blocks": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["simulation", "tests", "publication", "evidence"],
                    "properties": {
                      "simulation": { "type": "boolean" },
                      "tests": { "type": "boolean" },
                      "publication": { "type": "boolean" },
                      "evidence": { "type": "boolean" }
                    }
                  }
                }
              }
            },
            "diagnostics_truncated": { "type": "boolean" },
            "resource_snapshot": {
              "description": "The versions and digests of the resources the cross-resource checks read, exactly as POST /policy/validate reports them; null when the document did not parse.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["schema_version", "complete", "components"],
                  "properties": {
                    "schema_version": { "type": "string" },
                    "digest": { "$ref": "#/$defs/digest" },
                    "complete": { "type": "boolean" },
                    "components": { "type": "object" },
                    "unavailable": { "type": "array", "items": { "type": "string" } }
                  }
                }
              ]
            }
          }
        },
        "tests": {
          "oneOf": [
            { "$ref": "#/$defs/not_included" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["included", "results"],
              "properties": {
                "included": { "const": true },
                "results": {
                  "type": "object",
                  "required": ["schema_version", "status", "suite", "policy", "summary", "cases"],
                  "properties": {
                    "schema_version": { "const": "policy-test-results.v1" },
                    "status": { "enum": ["passed", "failed", "incomplete", "error"] },
                    "policy": {
                      "type": "object",
                      "required": ["source", "etag"],
                      "properties": { "source": { "enum": ["publication", "draft"] } }
                    }
                  }
                }
              }
            }
          ]
        },
        "simulation": {
          "oneOf": [
            { "$ref": "#/$defs/not_included" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "included",
                "mode",
                "trace",
                "projections",
                "base",
                "candidate",
                "not_evaluated",
                "summary",
                "cases"
              ],
              "properties": {
                "included": { "const": true },
                "mode": { "const": "synthetic" },
                "trace": { "enum": ["terminal", "matched"] },
                "projections": {
                  "type": "array",
                  "items": { "enum": ["as_authored", "enforce_all_shadow"] }
                },
                "base": {
                  "description": "What the candidate replaces, when every case was also decided under it: the predecessor's version and ETag for a publication, the live policy's ETag for a draft.",
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["etag"],
                      "properties": {
                        "version": { "$ref": "#/$defs/version" },
                        "etag": { "$ref": "#/$defs/etag" }
                      }
                    }
                  ]
                },
                "candidate": {
                  "description": "The publication's version and ETag, or the draft's revision and candidate ETag.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["etag"],
                  "properties": {
                    "version": { "$ref": "#/$defs/version" },
                    "draft_revision": { "type": "integer", "minimum": 1 },
                    "etag": { "$ref": "#/$defs/etag" }
                  }
                },
                "not_evaluated": { "type": "array", "items": { "type": "string" } },
                "summary": { "type": "object" },
                "cases": { "type": "array", "maxItems": 256, "items": { "type": "object" } }
              }
            }
          ]
        },
        "replay": {
          "oneOf": [
            { "$ref": "#/$defs/not_included" },
            {
              "type": "object",
              "required": [
                "included",
                "mode",
                "state",
                "candidate",
                "predecessor_check",
                "result_digest",
                "result"
              ],
              "properties": {
                "included": { "const": true },
                "mode": { "const": "historical_replay" },
                "state": { "enum": ["completed", "completed_incomplete"] },
                "predecessor_check": {
                  "enum": ["matches_predecessor", "differs_from_predecessor", "no_predecessor"]
                },
                "result_digest": { "$ref": "#/$defs/digest" },
                "result": { "type": "object" }
              }
            }
          ]
        },
        "analysis": {
          "oneOf": [
            { "$ref": "#/$defs/not_included" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "included",
                "artifact",
                "analyzer",
                "analyzed",
                "complete",
                "limitations",
                "suppressions",
                "summary",
                "findings"
              ],
              "properties": {
                "included": { "const": true },
                "artifact": { "$ref": "#/$defs/analysis_entry" },
                "analyzer": {
                  "type": "object",
                  "required": ["version"],
                  "properties": { "version": { "type": "string", "minLength": 1 } }
                },
                "analyzed": {
                  "type": "object",
                  "required": ["source", "etag"],
                  "properties": {
                    "source": { "enum": ["revision", "draft"] },
                    "etag": { "$ref": "#/$defs/etag" }
                  }
                },
                "complete": { "type": "boolean" },
                "limitations": {
                  "type": "array",
                  "items": {
                    "enum": ["comparison_budget_exhausted", "deadline_exceeded", "findings_truncated"]
                  }
                },
                "suppressions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["available", "records"],
                  "properties": {
                    "available": { "type": "boolean" },
                    "records": { "type": "integer", "minimum": 0 }
                  }
                },
                "summary": { "type": "object" },
                "findings": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": { "$ref": "#/$defs/finding" }
                }
              }
            }
          ]
        },
        "completeness": { "enum": ["complete", "incomplete"] },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "policy_semantic_digest_unavailable",
              "predecessor_not_in_history",
              "predecessor_differs_from_recorded_base",
              "validation_blocks_evidence",
              "validation_diagnostics_truncated",
              "tests_not_included",
              "tests_incomplete",
              "simulation_not_included",
              "simulation_base_not_evaluable",
              "replay_not_included",
              "replay_incomplete",
              "replay_base_not_predecessor",
              "analysis_not_included",
              "analysis_incomplete",
              "analysis_suppressions_unavailable"
            ]
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signed", "statement"],
          "properties": {
            "signed": { "const": false },
            "statement": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}

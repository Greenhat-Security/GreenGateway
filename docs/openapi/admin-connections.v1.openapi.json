{
  "openapi": "3.1.0",
  "info": {
    "title": "GreenGateway Connection and Capability Admin API",
    "version": "1.0.0",
    "description": "The default paths are shown with ADMIN_PREFIX=/admin. Replace /admin with the configured ADMIN_PREFIX while retaining the /v1 API prefix. Every route requires an authenticated principal and the operation-specific RBAC permission. Safe read responses and projected playground output never expose secret IDs, provider locators, ciphertext, nonces, key/private-key material, raw DNS or transport errors, or upstream response headers."
  },
  "servers": [
    {
      "url": "/",
      "description": "The active GreenGateway listener."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "tags": [
    {
      "name": "Connections"
    },
    {
      "name": "Connection secrets"
    },
    {
      "name": "Managed OpenAPI"
    },
    {
      "name": "Capabilities"
    }
  ],
  "paths": {
    "/v1/admin/connections": {
      "get": {
        "operationId": "listConnections",
        "tags": [
          "Connections"
        ],
        "summary": "List safe Connection summaries",
        "description": "Requires admin:connections:read. The opaque cursor is valid only with the same filters and current collection.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ConnectionLimit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "enabled",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionKind"
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionSource"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OperationalState"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe Connection page.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "x-greengateway-connections-etag": {
                "$ref": "#/components/headers/ConnectionCollectionETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        }
      },
      "post": {
        "operationId": "createConnection",
        "tags": [
          "Connections"
        ],
        "summary": "Create a managed Connection",
        "description": "Requires admin:connections:write. Configuring credential or TLS authority also requires admin:connections:secrets:write. enabled defaults to false when omitted.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created safe Connection detail.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "x-greengateway-connections-etag": {
                "$ref": "#/components/headers/ConnectionCollectionETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionDetail"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/v1/admin/connections/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StableId"
        }
      ],
      "get": {
        "operationId": "getConnection",
        "tags": [
          "Connections"
        ],
        "summary": "Get a redacted Connection detail",
        "description": "Requires admin:connections:read. Legacy projections use a collection-bound ETag and have all mutation actions disabled.",
        "responses": {
          "200": {
            "description": "Safe Connection detail.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionDetail"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        }
      },
      "put": {
        "operationId": "replaceConnection",
        "tags": [
          "Connections"
        ],
        "summary": "Replace a managed Connection",
        "description": "Requires admin:connections:write and an exact resource ETag. Explicit binding IDs, credential/TLS authority changes, and credentialed target changes require admin:connections:secrets:write. A caller may round-trip configured redaction markers instead of hidden IDs.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionReplaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated safe Connection detail.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "x-greengateway-connections-etag": {
                "$ref": "#/components/headers/ConnectionCollectionETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionDetail"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      },
      "delete": {
        "operationId": "deleteConnection",
        "tags": [
          "Connections"
        ],
        "summary": "Delete an unreferenced managed Connection",
        "description": "Requires admin:connections:write and an exact resource ETag. Deleting credential/TLS authority also requires admin:connections:secrets:write. There is no force-delete mode.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted Connection identifier.",
            "headers": {
              "x-greengateway-connections-etag": {
                "$ref": "#/components/headers/ConnectionCollectionETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionDeleted"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/v1/admin/connections/{id}/test": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StableId"
        }
      ],
      "post": {
        "operationId": "testConnection",
        "tags": [
          "Connections"
        ],
        "summary": "Run the saved bounded Connection test",
        "description": "Requires admin:connections:test, an exact resource ETag, and an empty body. Operational probe failures still return a sanitized 200 result; API/admission failures use HTTP errors.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Sanitized staged test result.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/ConnectionTestResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/v1/admin/connections/{id}/refresh": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StableId"
        }
      ],
      "post": {
        "operationId": "refreshConnectionCatalog",
        "tags": [
          "Connections"
        ],
        "summary": "Refresh a registered managed MCP or OpenAPI catalog",
        "description": "Requires admin:connections:refresh, an exact resource ETag, and an empty body. Failure leaves the prior catalog as last-known-good.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Safe catalog publication summary.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/CatalogPublishResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/v1/admin/connections/{id}/overlay": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StableId"
        }
      ],
      "get": {
        "operationId": "getConnectionOpenApiOverlay",
        "tags": [
          "Managed OpenAPI"
        ],
        "summary": "Read the stored OpenAPI overlay and its applied revision",
        "description": "Requires admin:connections:read. The overlay has its own strong ETag, whose Connection revision component prevents reuse across a compatible-ID kind replacement. Source status is projected from the canonical report snapshot stored with the overlay, including after restart; this read performs no source I/O.",
        "responses": {
          "200": {
            "description": "Stored overlay state. When no overlay exists, document is null, overlay_revision is 0, and the ETag ends in :o0.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/OpenApiOverlayETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayGetResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        }
      },
      "put": {
        "operationId": "putConnectionOpenApiOverlay",
        "tags": [
          "Managed OpenAPI"
        ],
        "summary": "Validate, compile, and atomically publish an OpenAPI overlay",
        "description": "Requires admin:connections:write and the exact overlay ETag. A raw source request.path on an authenticated Connection additionally requires admin:connections:secrets:write. Validation, source resolution, compilation, catalog publication, overlay persistence, and source-report persistence succeed as one mutation or leave the previous catalog and overlay unchanged.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpenApiOverlayIfMatch"
          },
          {
            "name": "allow_unresolved_enum_sources",
            "in": "query",
            "required": false,
            "description": "Permit an enum source with no initial value set to be stored unresolved. Label sources must still resolve. Source declarations are reserved and rejected by the current overlay schema revision.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Overlay and compiled catalog publication summary.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/OpenApiOverlayETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayMutationResponse"
                }
              }
            }
          },
          "412": {
            "$ref": "#/components/responses/AdminError"
          },
          "422": {
            "$ref": "#/components/responses/OpenApiOverlayValidationError"
          },
          "428": {
            "$ref": "#/components/responses/AdminError"
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      },
      "delete": {
        "operationId": "deleteConnectionOpenApiOverlay",
        "tags": [
          "Managed OpenAPI"
        ],
        "summary": "Remove an OpenAPI overlay and republish the bare catalog",
        "description": "Requires admin:connections:write and the exact overlay ETag. Bare generation, catalog replacement, overlay deletion, and source-report/value cleanup occur in one transaction; failure leaves the prior compiled catalog and overlay intact.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpenApiOverlayIfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Bare catalog publication summary; overlay_revision is 0.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/OpenApiOverlayETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiOverlayMutationResponse"
                }
              }
            }
          },
          "412": {
            "$ref": "#/components/responses/AdminError"
          },
          "428": {
            "$ref": "#/components/responses/AdminError"
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/v1/admin/connections/{id}/openapi/preview": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StableId"
        }
      ],
      "post": {
        "operationId": "previewManagedOpenApi",
        "tags": [
          "Managed OpenAPI"
        ],
        "summary": "Preview a bounded OpenAPI document without persistence",
        "description": "Requires admin:tools:read. Preview performs no tool invocation or persistence and returns the current Connection ETag for a later register precondition. When an optional overlay declares supported sources, preview performs the same bounded source resolution as overlay PUT so the operator sees compiled labels and values before storing anything.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiPreviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic generated catalog preview.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/connection-admin.v1.schema.json#/$defs/OpenApiPreviewResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AdminError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/v1/admin/connections/{id}/openapi/register": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StableId"
        }
      ],
      "post": {
        "operationId": "registerManagedOpenApi",
        "tags": [
          "Managed OpenAPI"
        ],
        "summary": "Persist and publish an explicit OpenAPI selection",
        "description": "Requires admin:tools:write and the exact Connection ETag. The repeated spec/digest/revisions bind registration to the reviewed preview. The request shape is unchanged; registration compiles and publishes the stored overlay when one exists.",
